+def _qualitative(value: float) -> str:
+    """§四 数值 → 定性词（建议值只给方向，不给数字）。"""
+    if value >= 0.8:
+        return "高"
+    if value >= 0.65:
+        return "中高"
+    if value >= 0.45:
+        return "中"
+    if value >= 0.3:
+        return "中低"
+    return "低"
+
