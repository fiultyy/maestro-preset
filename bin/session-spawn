#!/usr/bin/env python3
"""session-spawn — 按舰队规范 spawn 新 main 会话(出生入组+命名+登记)

用法: session-spawn <preset> <node> <purpose> [workspaceId]
  返回: 4 位码(sessionId 前 4 hex,UUID 派生,零额外状态)

做四件事:
  1. session.create {workspaceId, agentPreset}   — 出生入账(可见性前提)
  2. code = sessionId 前 4 位
  3. session.rename "ORCH/<node>-<code> · <preset> · <purpose>(active)"
  4. fleet.json 登记(原子写)并回显 code

环境: DSH_PORT(默认 3080)/ MAESTRO_FLEET(默认 ~/.dsh/maestro/fleet.json)
"""
import json
import os
import sys
import tempfile
import urllib.request
import uuid


def rpc(port: str, method: str, payload: dict) -> dict:
    wire = {
        'type': 'client-request',
        'rpcId': str(uuid.uuid4()),
        'method': method,
        'payload': payload,
    }
    req = urllib.request.Request(
        f'http://127.0.0.1:{port}/api/{method}',
        data=json.dumps(wire, ensure_ascii=False).encode(),
        headers={'content-type': 'application/json'},
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        result = json.loads(resp.read())['result']
    if not result.get('ok'):
        sys.exit(f'session-spawn: {method} failed: {json.dumps(result.get("error"), ensure_ascii=False)}')
    return result['value']


def atomic_write_json(path: str, obj: dict) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix='.fleet-', suffix='.json')
    try:
        with os.fdopen(fd, 'w') as fh:
            json.dump(obj, fh, ensure_ascii=False, indent=2)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def bridge_register(sid: str, alias: str) -> None:
    """P4+: 起会话即入桥册(host lane registry.json)——断路修复件 2/3。

    桥只投递给在册消费者;:3080 重启会杀全部在册条目,靠会话自己 re-arm 从未发生
    (2026-08-26 实证)。spawn 面是唯一"会话生命起点",在此挂注册 = 编排者/worker
    零心智。桥属旁路面:不可用只 warn,绝不阻断 spawn。
    """
    bridge = os.environ.get('MAESTRO_BRIDGE', os.path.expanduser('~/.dsh/maestro/bridge'))
    port_file = os.path.join(bridge, 'http.port')
    try:
        port = open(port_file).read().strip()
        req = urllib.request.Request(
            f'http://127.0.0.1:{port}/register',
            data=json.dumps({'sessionId': sid, 'alias': alias}).encode(),
            headers={'content-type': 'application/json'},
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            ack = json.loads(resp.read())
        warn = ack.get('warning')
        if warn:  # 多编排者撞名: 注册成功但裸别名寻址将死信, 提示编排者差异化别名
            print(f'bridge-rearm: WARNING {warn}', file=sys.stderr)
        print(f'bridge-rearm: registered {alias}@{sid[:18]}', file=sys.stderr)
    except Exception as exc:  # noqa: BLE001 — 旁路面, 任何失败都只 warn
        print(f'bridge-rearm: register skipped ({exc}); session works, callbacks need POST /register', file=sys.stderr)


def main() -> None:
    if len(sys.argv) not in (4, 5):
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    preset, node, purpose = sys.argv[1:4]
    fleet_path = os.environ.get('MAESTRO_FLEET', os.path.expanduser('~/.dsh/maestro/fleet.json'))
    with open(fleet_path) as fh:
        fleet = json.load(fh)
    port = str(fleet.get('port', os.environ.get('DSH_PORT', '3080')))
    ws = sys.argv[4] if len(sys.argv) == 5 else fleet.get('defaultWorkspaceId')
    if not ws:
        sys.exit('session-spawn: no workspaceId given and fleet.json has no defaultWorkspaceId')

    created = rpc(port, 'session.create', {'workspaceId': ws, 'agentPreset': preset})
    sid = created['sessionId']
    code = sid.removeprefix('session-')[:4]
    title = f'{code}-{node} · {preset} · {purpose}(active)'
    rpc(port, 'session.rename', {'sessionId': sid, 'title': title})

    fleet['fleet'][code] = {
        'sessionId': sid,
        'role': 'worker',
        'node': node,
        'preset': preset,
        'spawnedAt': __import__('datetime').datetime.now(__import__('datetime').timezone.utc).isoformat(),
        'status': 'active',
    }
    atomic_write_json(fleet_path, fleet)
    bridge_register(sid, node)
    print(code)


if __name__ == '__main__':
    main()
