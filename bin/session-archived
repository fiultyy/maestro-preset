#!/usr/bin/env python3
"""session-archived — 判定 sessionId/code 是否已在归档集(读侧, 零写入)

用法:
  session-archived <sessionId|code>… [--fleet <fleet.json>] [--port <n>] [--selftest]

输出: JSON 数组, 与入参同序; 每元素:
  {"id": <原样入参>, "sessionId": <解析出的全 id | null>, "archived": bool}
  code 解析规则与 session-send 同款: fleet 表键(短码/终端 handle), 或
  sessionId 前缀("aa11" → session-aa11…); 完整 sessionId 直用不经 fleet。
  解析失败 → {"id":…, "sessionId": null, "archived": false, "note": "unresolved"}。

判定: 经 dsh loopback API 调 workspace.list 取 archivedSessionIds 逐一比对
      (比较在剥去 "session-" 前缀后进行)。

幂等: 纯只读; 重复运行输出一致。
退出码: 0 恒定(判定结果在 stdout 表达——archived/unresolved 都是正常业务态,
      不用退出码表达); 1 = loopback API 失败; 3 = fleet.json 缺失/损坏(仅当
      需要经它解析 code 时); 2 = 用法错(缺参数)。

环境: MAESTRO_HOME(默认 ~/.dsh) · MAESTRO_FLEET(默认 $MAESTRO_HOME/maestro/fleet.json)
      DSH_PORT(默认取 fleet.json 的 port, 再缺省 3080);--fleet/--port 显式覆盖优先。
"""
import argparse
import json
import os
import sys
import urllib.request
import uuid

HOME = os.environ.get('MAESTRO_HOME', os.path.expanduser('~/.dsh'))
FLEET_DEFAULT = os.environ.get('MAESTRO_FLEET') or os.path.join(HOME, 'maestro', 'fleet.json')


def die(msg, code=1):
    print(f'session-archived: {msg}', file=sys.stderr)
    sys.exit(code)


def load_fleet(path):
    try:
        with open(path, encoding='utf-8') as fh:
            data = json.load(fh)
    except FileNotFoundError:
        die(f'fleet.json not found: {path}', 3)
    except json.JSONDecodeError as exc:
        die(f'fleet.json 损坏: {exc}', 3)
    if not isinstance(data, dict) or not isinstance(data.get('fleet'), dict):
        die("fleet.json 结构异常: 顶层缺 'fleet' 对象", 3)
    return data


def resolve(key, fleet):
    """session-send 同款解析: 完整 sessionId 直用 → fleet 键 → 前缀; 失败 None。"""
    if key.startswith('session-'):
        return key
    entry = fleet.get('fleet', {}).get(key)
    if isinstance(entry, dict) and entry.get('sessionId'):
        return entry['sessionId']
    for ent in fleet.get('fleet', {}).values():
        if isinstance(ent, dict) and ent.get('sessionId', '').startswith('session-' + key):
            return ent['sessionId']
    return None


def rpc(port, method, payload):
    wire = {'type': 'client-request', 'rpcId': str(uuid.uuid4()),
            'method': method, 'payload': payload}
    req = urllib.request.Request(
        f'http://127.0.0.1:{port}/api/{method}',
        data=json.dumps(wire, ensure_ascii=False).encode(),
        headers={'content-type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            result = json.loads(resp.read())['result']
    except Exception as exc:  # noqa: BLE001 — 连接/HTTP/解析任一失败都归 API 失败
        die(f'{method} 调用失败: {exc}', 1)
    if not result.get('ok'):
        die(f'{method} RPC error: {json.dumps(result.get("error"), ensure_ascii=False)}', 1)
    return result['value']


def bare(sid):
    return str(sid or '').removeprefix('session-')


def run(args, path, port):
    need_fleet = not all(a.startswith('session-') for a in args)
    fleet = load_fleet(path) if need_fleet else {}
    if port is None:
        port = os.environ.get('DSH_PORT') or str(fleet.get('port') or '3080')
    archived = {bare(s) for s in rpc(port, 'workspace.list', {}).get(
        'archivedSessionIds', [])}
    out = []
    for key in args:
        sid = resolve(key, fleet)
        item = {'id': key, 'sessionId': sid, 'archived': bool(sid) and bare(sid) in archived}
        if not sid:
            item['note'] = 'unresolved'
        out.append(item)
    print(json.dumps(out, ensure_ascii=False, indent=2))


# ---------- selftest ----------

def selftest():
    import shutil
    import subprocess
    import tempfile
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    tmp = tempfile.mkdtemp(prefix='sa-selftest-')

    class FakeDSH(BaseHTTPRequestHandler):
        def do_POST(self):
            body = {'items': [], 'archivedSessionIds': ['session-aa11', 'session-dd44']}
            value = json.dumps({'type': 'server-response', 'rpcId': 'stub',
                                'result': {'ok': True, 'value': body}}).encode()
            self.send_response(200)
            self.send_header('content-type', 'application/json')
            self.send_header('content-length', str(len(value)))
            self.end_headers()
            self.wfile.write(value)

        def log_message(self, *args):
            pass

    server = ThreadingHTTPServer(('127.0.0.1', 0), FakeDSH)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    port = str(server.server_address[1])

    def run_cli(args):
        return subprocess.run([sys.executable, os.path.abspath(__file__), *args],
                              capture_output=True, text=True, timeout=60)

    def fresh(name):
        path = os.path.join(tmp, name)
        with open(path, 'w', encoding='utf-8') as fh:
            json.dump({'port': 3080, 'defaultWorkspaceId': 'ws-x', 'fleet': {
                'aa11': {'sessionId': 'session-aa11', 'role': 'worker', 'status': 'active'},
                'bb22': {'sessionId': 'session-bb22', 'role': 'worker', 'status': 'active'},
            }}, fh)
        return path

    results = []

    def check(name):
        def deco(fn):
            results.append((name, fn))
            return fn
        return deco

    @check('sa:mixed-verdicts-by-code')
    def _():
        t = fresh('f1.json')
        proc = run_cli(['aa11', 'bb22', '--fleet', t, '--port', port])
        assert proc.returncode == 0, proc.stderr
        out = json.loads(proc.stdout)
        assert out == [{'id': 'aa11', 'sessionId': 'session-aa11', 'archived': True},
                       {'id': 'bb22', 'sessionId': 'session-bb22', 'archived': False}], out

    @check('sa:full-sessionid-direct')
    def _():
        proc = run_cli(['session-dd44', '--fleet', os.path.join(tmp, 'nope.json'),
                        '--port', port])  # 全 id 入参: 不需要 fleet.json
        assert proc.returncode == 0, proc.stderr
        assert json.loads(proc.stdout) == [
            {'id': 'session-dd44', 'sessionId': 'session-dd44', 'archived': True}]

    @check('sa:unknown-code-unresolved-exit0')
    def _():
        t = fresh('f2.json')
        proc = run_cli(['zz99', '--fleet', t, '--port', port])
        assert proc.returncode == 0, '业务态不用退出码表达'
        out = json.loads(proc.stdout)
        assert out == [{'id': 'zz99', 'sessionId': None, 'archived': False,
                        'note': 'unresolved'}], out

    @check('sa:idempotent-replay')
    def _():
        t = fresh('f3.json')
        args = ['aa11', 'bb22', 'zz99', 'session-dd44', '--fleet', t, '--port', port]
        outs = [run_cli(args).stdout for _ in range(2)]
        assert outs[0] == outs[1] and outs[0].strip(), outs

    @check('sa:api-down-exit1')
    def _():
        t = fresh('f4.json')
        proc = run_cli(['aa11', '--fleet', t, '--port', '1'])
        assert proc.returncode == 1, (proc.returncode, proc.stderr)
        assert 'workspace.list' in proc.stderr

    @check('sa:missing-args-exit2')
    def _():
        proc = run_cli([])
        assert proc.returncode == 2, (proc.returncode, proc.stderr)

    @check('sa:missing-fleet-exit3-when-resolving')
    def _():
        proc = run_cli(['aa11', '--fleet', os.path.join(tmp, 'nope2.json'), '--port', port])
        assert proc.returncode == 3, (proc.returncode, proc.stderr)

    npass = 0
    for name, fn in results:
        try:
            fn()
        except AssertionError as exc:
            print(f'[FAIL] {name}: {exc}')
        except Exception as exc:  # noqa: BLE001
            print(f'[FAIL] {name}: unexpected {type(exc).__name__}: {exc}')
        else:
            print(f'[ ok ] {name}')
            npass += 1
    server.shutdown()
    shutil.rmtree(tmp, ignore_errors=True)
    print(f'session-archived selftest: {npass}/{len(results)} passed')
    return 0 if npass == len(results) else 1


def main():
    ap = argparse.ArgumentParser(prog='session-archived',
                                 description='judge sessionIds/codes against the archive set')
    ap.add_argument('ids', nargs='*', help='sessionId 或 fleet 短码, 可多个')
    ap.add_argument('--fleet', default=None, help='fleet.json 路径(默认 $MAESTRO_FLEET)')
    ap.add_argument('--port', default=None, help='loopback 端口(默认 $DSH_PORT / fleet.port / 3080)')
    ap.add_argument('--selftest', action='store_true', help='内置自测(stub API + temp 目录, 不碰真实状态)')
    a = ap.parse_args()
    if a.selftest:
        sys.exit(selftest())
    if not a.ids:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    run(a.ids, a.fleet or FLEET_DEFAULT, a.port)


if __name__ == '__main__':
    main()
