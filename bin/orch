#!/usr/bin/env python3
"""orch — Orca 编排面高抽象入口 CLI(债#9×#11):一次调用 = 一个生命周期动作 + ledger 自动建账
用法:
  orch dispatch --spec <file|-> [--to <handle>] [--run <run_id> | --new-run "<objective>"]
                [--title <t>] [--ref <ref>] [--project <key|path>] [--force]
                [--no-ticket] [--dry-run] [--json]
  orch settle   [--run <run_id>] [--project <key|path>] [--json]
                (--payload-file <f> | --payload <json> | --payload -)   # 回调收讫结算(非阻塞;阻塞 wait 已退役)
  orch dag-seat-open --project <path> [--title T] [--base-branch B]   # dag 族: 编排席终端幂等创建/复用
  orch dag-run "<objective>"                          # dag 族: 幂等建/续 Run
  orch dag-task <REF> --title <t> --spec <s> [--deps R1,R2]   # dag 族: Orca task+ticket 环原子建(deps 硬屏障)
  # HOOK-ENVELOPE: dag-task 落 task 文本首行自动构造 DSHMSG 派票信封(from=编排席签名,to="-",type=dispatch,ref=票REF,msgid=uuid4,ver=3;
  #   消费端 ups 钩 NR==1 只认首行 → 落 inflight(5 列含 FROM) → turn_end 配对回 ticket-done(to=信封 FROM 来路即目标);
  #   签名必传(SIG-MANDATE,issue#1): --orch-sig 旗标或 env ORCH_SIG,零静默回落(缺席 exit 2 附本席签名获取法))
  orch dag-seat <REF> [--name <worktree>]             # dag 族: worker-start(omp×新顶层worktree)+dispatched 双写
  orch reply    --msg <msg_id> (--body <text> | --body-file <f>) [--run <run_id>] [--json]
  orch status   [--run <run_id>] [--ref <ref>] [--project <key|path>] [--json]
  orch selftest                       # 离线自测(fake ORCH_BIN stub 全链走查,零实弹)
  orch _transition --project <k> --node <id> --to <status> [--source s]
                                      # 内部: 显式状态机迁移(自测/人工修复用)
机制:
  - 正统链封装(链序固化): run-create/run-use → task-create → dispatch --inject →
    完成等待=回调单车道(worker_done 原生唤醒编排席回合,ADR-013;收讫结算 orch settle:
    worker_done→check --ack+worker-release+记账 | escalation→ack+release |
    question→不动,等编排席 reply);旗标以 orca-ide 动态 guide 为准,链序以本文件为准。
  - ledger 自动建账(编排席规则7/8 硬机制): dispatch → node(dispatched)+event;
    收果 → node end/blocked + outcome 事件(≤300字);tickets 环(ticket add/lease/state)
    同步勾稽 —— pm-host-service PM-003 票源 = `ledger ticket list --json`(ledger.db
    tickets 表,db 签名是 freshness authority),写 tickets 环 pm-web 票面才自然更新。
  - 状态机在代码里强制(node status 为准): dispatched→{running,blocked};
    running→{end,failed,blocked};blocked→{running,end,failed};end/failed 终态;
    同态重写=幂等 no-op;表外流转一律拒绝(exit 1)。ledger ticket 侧另有内置状态机,
    本工具按其迁移表求最短合法路径逐步迁移,拒绝即 fail-loud。
  - running 帧消费(orch-hooks sidecar,worker 侧 turn-start hook 产出;桥 inbox 不涉及):
    status/settle/dag-status/dag-settle 进门先 tail 增量(字节游标,原子推进)收 type=ticket-running 帧 →
    dispatch 节点(及 ticket 环)dispatched→running;寻址(to==ORCH_SIG)+ref/task 双路
    解析(ref→node_id;task_*→refs.task;body [task:..] 兜底)+现态幂等(已 running/end 跳过)。
  - 幂等: deliveryId 记账于 <state>/orch-deliveries.json(原子写),重复 settle 收到同一
    delivery 不二次 ack/收尾/记账;同一 ref 重复 dispatch 默认拒(--force 放行并记 duplicate)。
  - 零实弹默认: 所有 orca-ide 调用可经 ORCH_BIN 注入 stub;--dry-run 只打印命令序列,
    零 orca/ledger 写路径调用。实弹冒烟归编排席。
  - bridge 武装硬门(ORCH-WAKE ②): --wait 阻塞等待已退役(ADR-013),回调是完成等待唯一手段 ——
    dispatch(含 --dry-run)要求本席在 bridge/registry.json 有在册 consumer(非 stale),
    否则 exit 1 并给 arm 指引;无回信地址的派工其完成信号必然丢失,故默认强制。
  - dag 族(ORCH-UNIFY 收编自 orch-dag,唯一入口=orch): 原子生命周期
    dag-seat-open→dag-run→dag-task[--deps]→dag-seat→(回调)dag-settle→dag-close;
    agent 固定 omp、worktree 固定 new-top-level、tickets 环强制勾稽、零模式旗标;
    deps 屏障三层=本地依赖未建 fail-loud → Orca task_not_startable 硬拒绝透传 →
    ledger 票面 deps 未就绪拒迁 running/end;派发链四命令(dag-seat-open/run/task/
    seat)同过 bridge 武装硬门(V3: 未武装拒派);--base-branch 收编自 dbdeb83
    (repo 默认基点变更后的双保险: 落 state.worker_base_ref,dag-seat 透传 worker-start);
    状态文件 ORCH_DAG_STATE(缺省 <state>/orch-dag.json,承 orch-dag 旧档)。
  - fail-loud(ops 工具非 hook): 失败非零退出 + 明确 stderr,不静默吞;不打印任何 token/secret。
环境:
  ORCH_BIN          覆盖 orca CLI(测试 stub 注入口;最高优先)
  ORCA_CLI_COMMAND  orca CLI 覆盖(既有惯例,次优先)
  (缺省)            /opt/Orca/resources/bin/orca-ide —— 绝对禁止裸调 `orca`(GNOME 读屏器)
  MAESTRO_HOME      默认 ~/.dsh;maestro 面 = $MAESTRO_HOME/maestro
  MAESTRO_LEDGER    ledger.db 路径覆盖(透传给 ledger CLI,自测隔离用)
  ORCH_STATE_DIR    状态文件目录覆盖(默认 <maestro>/state;自测隔离用)
  ORCH_RUNNING_LOG  running 帧 sidecar 覆盖(默认 <maestro>/orch-hooks/running.log)
  ORCH_SIG          本席签名(to 寻址匹配;缺省 MAESTRO_ORCH_SIGNATURE 或 bridge/orch.signature;
                     亦为 bridge 武装硬门的 caller 身份)
   ORCH_BRIDGE_REGISTRY  bridge/registry.json 路径覆盖(硬门在册检查;自测隔离用)
退出码: 0 成功 · 1 状态机/重复拒绝/bridge 未武装硬门 · 2 question(等裁决) · 3 escalation(已 ack+release)
        5 运行失败 · 64 用法错误(缺参由 argparse 层 exit 2,dag 族契约同)
"""
import argparse, json, os, re, sqlite3, subprocess, sys, tempfile, uuid
from datetime import datetime, timezone

# ── 路径与 CLI 解析 ───────────────────────────────────────────────────────────
MAESTRO_HOME = os.environ.get('MAESTRO_HOME', os.path.expanduser('~/.dsh'))
MAESTRO_DIR = os.path.join(MAESTRO_HOME, 'maestro')
LEDGER_BIN = os.path.join(MAESTRO_DIR, 'bin', 'ledger')
DB = os.environ.get('MAESTRO_LEDGER', os.path.join(MAESTRO_DIR, 'ledger.db'))
STATE_DIR = os.environ.get('ORCH_STATE_DIR', os.path.join(MAESTRO_DIR, 'state'))
DEFAULT_ORCA = '/opt/Orca/resources/bin/orca-ide'
# running 帧 sidecar(worker 侧 turn-start hook 追加;桥 inbox 不涉及 running 帧):
RUNNING_LOG = os.environ.get('ORCH_RUNNING_LOG', os.path.join(MAESTRO_DIR, 'orch-hooks', 'running.log'))

def orca_bin():
    return os.environ.get('ORCH_BIN') or os.environ.get('ORCA_CLI_COMMAND') or DEFAULT_ORCA

def now():
    return datetime.now(timezone.utc).isoformat(timespec='seconds')

def die(msg, code=1):
    print(f'orch: {msg}', file=sys.stderr)
    sys.exit(code)

def require_ledger():
    if not os.path.isfile(LEDGER_BIN):
        die(f'ledger CLI 不存在: {LEDGER_BIN}(编排面未部署?)', 5)

# ── 状态机(硬机制,代码强制) ──────────────────────────────────────────────────
# node 侧(ledger nodes.status,本工具强制;ledger 本体对 node 不设状态机):
NODE_TRANSITIONS = {
    'dispatched': {'running', 'blocked'},
    'running':    {'end', 'failed', 'blocked'},
    'blocked':    {'running', 'end', 'failed'},
    'end':       set(),
    'failed':     set(),
}
NODE_TERMINAL = {'end', 'failed'}
# ticket 侧(ledger 内置状态机,~/.dsh/maestro/bin/ledger TICKET_TRANSITIONS 的镜像;
# 镜像仅用于求最短合法路径,真实校验仍由 ledger 拒绝兜底 —— 漂移即 fail-loud):
TICKET_TRANSITIONS = {
    'dispatched':  {'running', 'rejected'},
    'running':     {'blocked', 'end', 'rejected'},
    'blocked':     {'running', 'end', 'rejected'},
    'end':        {'running', 'merged', 'rejected'},
    'merged':      {'rolled-back'},
    'rejected':    set(),
    'rolled-back': set(),
}

def check_node_transition(cur, nxt):
    """严格单边校验(_transition 手工迁移用): 同态=幂等 no-op;表外流转拒绝。"""
    if cur == nxt:
        return 'noop'
    if nxt not in NODE_TRANSITIONS.get(cur, set()):
        die(f"非法状态流转: {cur} -> {nxt}(合法: {', '.join(sorted(NODE_TRANSITIONS.get(cur, set()))) or '无(终态)'})", 1)
    return 'ok'

def _bfs_path(transitions, cur, target):
    """BFS 最短合法路径;重构止于 cur(不含起点),不可达返回 None,同态 []。"""
    if cur == target:
        return []
    from collections import deque
    q, prev = deque([cur]), {cur: None}
    while q:
        s = q.popleft()
        for t in transitions.get(s, set()):
            if t in prev:
                continue
            prev[t] = s
            if t == target:
                chain = [t]
                while chain[-1] != cur:          # 回溯到起点为止
                    chain.append(prev[chain[-1]])
                return list(reversed(chain[:-1]))  # 丢掉起点: 步序表只含迁移目标
            q.append(t)
    return None

def ticket_path(cur, target):
    """ledger ticket 状态机最短合法路径(镜像表求导;真校验仍由 ledger 拒绝兜底)。"""
    return _bfs_path(TICKET_TRANSITIONS, cur, target)

def node_path(cur, target):
    """node 状态机最短合法路径(wait 收尾自动补中间态用)。"""
    return _bfs_path(NODE_TRANSITIONS, cur, target)

# ── 原子状态文件(幂等账: deliveries / last-run) ──────────────────────────────
def _atomic_write_json(path, data):
    d = os.path.dirname(os.path.abspath(path))
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix='.orch-state-')
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=1)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise

def _read_json(path, default):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except (json.JSONDecodeError, OSError) as e:
        die(f'状态文件损坏: {path}: {e}', 5)

def state_file(name):
    return os.path.join(STATE_DIR, name)

def load_deliveries():
    return _read_json(state_file('orch-deliveries.json'), {})

def delivery_seen(run, delivery_id):
    return delivery_id in load_deliveries().get(run, {})

def record_delivery(run, delivery_id, mtype, outcome):
    data = load_deliveries()
    data.setdefault(run, {})[delivery_id] = {'type': mtype, 'outcome': (outcome or '')[:300], 'at': now()}
    _atomic_write_json(state_file('orch-deliveries.json'), data)

def load_last_run():
    return _read_json(state_file('orch-last-run.json'), None)

def save_last_run(rec):
    rec = dict(rec)
    rec['updated_at'] = now()
    _atomic_write_json(state_file('orch-last-run.json'), rec)

# ── orca-ide 调用(命令序列可 dry-run 打印) ────────────────────────────────────
PLAN = []   # dry-run 收集将执行的命令序列

def plan(cmd_argv):
    PLAN.append(cmd_argv)
    print('[dry] ' + ' '.join(cmd_argv), file=sys.stderr)

def run_orca(argv, timeout=90):
    """执行 orca CLI 子命令(argv 为去二进制的参数表);返回 (rc, stdout, stderr)。"""
    cmd = [orca_bin(), *argv]
    if os.environ.get('ORCH_DRYRUN'):   # dry-run 深度:只打印不执行
        plan(cmd)
        return 0, '', ''
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        die(f'orca CLI 不可执行: {orca_bin()}(检查 ORCH_BIN/ORCA_CLI_COMMAND 或安装面)', 5)
    except subprocess.TimeoutExpired:
        die(f'orca CLI 超时: {" ".join(cmd)}', 5)

def orca_json(argv, what, timeout=90):
    """执行并解析 --json 输出;失败 fail-loud(exit 5)。"""
    rc, out, err = run_orca(argv + ['--json'], timeout=timeout)
    if rc != 0:
        die(f'{what} 失败(rc={rc}): {(err or out).strip()[:400]}', 5)
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        die(f'{what} 输出非 JSON: {(out or err).strip()[:400]}', 5)

# ── 灵活字段提取(orca-ide JSON 形态以键名优先+值模式双路匹配) ─────────────────
def _walk(obj):
    if isinstance(obj, dict):
        for k, v in obj.items():
            yield k, v
            yield from _walk(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from _walk(v)

def find_prefixed(doc, prefix):
    """递归找首个以 prefix 开头的字符串值(run_/task_/ctx_ 等)。"""
    for _k, v in _walk(doc):
        if isinstance(v, str) and v.startswith(prefix):
            return v
    return None

def find_key(doc, *names):
    """递归找首个命中键名的值(键名优先,大小写/下标不敏感)。"""
    want = {n.lower() for n in names}
    for k, v in _walk(doc):
        if isinstance(k, str) and k.lower() in want and v not in (None, '', [], {}):
            return v
    return None

def find_delivery_id(doc):
    v = find_key(doc, 'deliveryId', 'delivery_id', 'delivery')
    return v if isinstance(v, str) else None

def find_messages(doc):
    v = find_key(doc, 'messages')
    if isinstance(v, list):
        return [m for m in v if isinstance(m, dict)]
    # 扁平形态: doc 本身就是单条消息
    if isinstance(doc, dict) and 'type' in doc and ('id' in doc or 'body' in doc):
        return [doc]
    return []

def msg_payload_dict(msg):
    p = msg.get('payload', msg.get('body'))
    if isinstance(p, str):
        try:
            p = json.loads(p)
        except json.JSONDecodeError:
            return {}
    return p if isinstance(p, dict) else {}

# ── ledger 调用(复用既有工具,零直写) ─────────────────────────────────────────
def run_ledger(args, check=True):
    require_ledger()
    cmd = [sys.executable, LEDGER_BIN, *args]
    if os.environ.get('ORCH_DRYRUN'):
        plan(cmd)
        return ''
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    if check and p.returncode != 0:
        die(f'ledger {" ".join(args[:2])} 失败(rc={p.returncode}): {(p.stderr or p.stdout).strip()[:400]}', 5)
    return p.stdout

def read_only_db():
    """只读连接(读路径不建 schema 不落锁,同 ledger 读侧纪律)。"""
    return sqlite3.connect(f'file:{DB}?mode=ro', uri=True)

def resolve_project_key(ident):
    """复刻 ledger resolve_project 语义(只读): key 或 path → key。找不到返回 None。"""
    try:
        c = read_only_db()
    except sqlite3.OperationalError as e:
        die(f'ledger.db 不可读: {e}', 5)
    try:
        row = c.execute("SELECT key FROM projects WHERE key=? OR path=?", (ident, ident)).fetchone()
        return row[0] if row else None
    except sqlite3.OperationalError:
        return None
    finally:
        c.close()

def get_node(project_ident, node_id):
    """只读取 node 行;无表/无行/库未建返回 None。
    (ORCH-UNIFY 修: connect 失败与查询失败分离——库文件不存在时 mode=ro connect 即抛,
    旧写法 finally 踩未绑定 c → UnboundLocalError。)"""
    key = resolve_project_key(project_ident)
    if not key:
        return None
    try:
        c = read_only_db()
    except sqlite3.OperationalError:
        return None
    try:
        row = c.execute("SELECT node_id,kind,title,status,owner,refs,updated_at FROM nodes WHERE project_key=? AND node_id=?",
                        (key, node_id)).fetchone()
        return dict(zip(['node_id', 'kind', 'title', 'status', 'owner', 'refs', 'updated_at'], row)) if row else None
    except sqlite3.OperationalError:
        return None
    finally:
        c.close()

def refs_as_dict(raw):
    """refs 字段安全归一(实测定界: 账内存有 list/标量/null 字面量/非 JSON 多形态):
    dict→原样;list/标量(None 字面量解析出非 dict 等)→{}+WARN;SQL NULL/空→{} 无 WARN;
    坏 JSON→{}+WARN。绝不 raise,坏值原样进 WARN 由调用方渲染,不中断。"""
    if raw is None or raw == '':
        return {}, None
    try:
        v = json.loads(raw)
    except (json.JSONDecodeError, TypeError, ValueError):
        return {}, f'refs 非 JSON: {str(raw)[:60]!r}'
    if isinstance(v, dict):
        return v, None
    return {}, f'refs 为 {type(v).__name__} 非 dict: {str(raw)[:60]}'

def find_node_by_run(run_id):
    """跨项目按 refs.run 找 orch 节点(settle 无 last-run 时兜底);库未建/无表→None。"""
    try:
        c = read_only_db()
    except sqlite3.OperationalError:
        return None
    try:
        rows = c.execute("SELECT project_key,node_id,kind,title,status,refs FROM nodes WHERE refs LIKE ?",
                         (f'%{run_id}%',)).fetchall()
    except sqlite3.OperationalError:
        return None
    finally:
        c.close()
    for r in rows:
        refs, _warn = refs_as_dict(r[5])
        if refs.get('run') == run_id:
            return {'project': r[0], 'node_id': r[1], 'kind': r[2], 'title': r[3], 'status': r[4], 'refs': refs}
    return None

def get_ticket(tid):
    try:
        c = read_only_db()
    except sqlite3.OperationalError:
        return None
    try:
        row = c.execute("SELECT ticket_id,state,lease_owner FROM tickets WHERE ticket_id=?", (tid,)).fetchone()
        return {'state': row[1], 'lease_owner': row[2]} if row else None
    except sqlite3.OperationalError:
        return None
    finally:
        c.close()

def ticket_exists(tid):
    try:
        c = read_only_db()
    except sqlite3.OperationalError:
        return False
    try:
        return c.execute("SELECT 1 FROM tickets WHERE ticket_id=?", (tid,)).fetchone() is not None
    except sqlite3.OperationalError:
        return False
    finally:
        c.close()

# ── running 帧消费(orch-hooks sidecar → dispatch 节点 running 段记账) ─────────
# worker 侧 turn-start hook(编排席维护)对 dispatch 注入票发 {"type":"ticket-running",
# "from":<worker session>,"to":ORCH_SIG,"body":"[task:task_..] worker turn started…",
# "ref":<ref,不可得则 task_id>,"msgid","ts","ver":3} 到 <maestro>/orch-hooks/running.log。
# CLI 消费形态: wait/status 进门先 tail 增量(字节游标,原子推进),寻址校验+双路解析
# (ref→node_id;task_*→refs.task)→ 仅 dispatched 现态迁 running(node+ticket 环),
# 已 running/end 等一律幂等跳过。游标+现态双保险,同帧/同 task 不重复记账。

def orch_sig():
    sig = os.environ.get('ORCH_SIG') or os.environ.get('MAESTRO_ORCH_SIGNATURE')
    if sig:
        return sig.strip()
    try:
        with open(os.path.join(MAESTRO_DIR, 'bridge', 'orch.signature'), encoding='utf-8') as f:
            return f.read().strip()
    except OSError:
        return None

# ── bridge 武装硬门(ORCH-WAKE 契约修复②,用户裁决 2026-09-09) ─────────────────
# 「CB 桥武装应该默认强制的。契约中完全移除阻塞 check(--wait),反而是武装回调是唯一
#  选项,减少 agent 行为选择性。」—— 回调是完成等待的唯一手段后,无回信地址的
# 派工其完成信号必然丢失(BRIDGE-WAKE 断腿同源)。故 dispatch(含 --dry-run)前置
# 硬门: caller 会话(orch_sig() 解析 @ 后 sessionId)必须在 bridge/registry.json
# 有在册 consumer(非 stale),否则拒绝并给 arm 指引。注册表路径可经
# ORCH_BRIDGE_REGISTRY 覆盖(自测隔离)。

def bridge_arm_gate(sig=None):
    reg = os.environ.get('ORCH_BRIDGE_REGISTRY') or os.path.join(MAESTRO_DIR, 'bridge', 'registry.json')
    sig = ((sig or '').strip() or orch_sig())   # SIG-MANDATE: 调用方显式签名优先——检查的是真 caller 会话,非共享签名文件身份

    def refuse(why):
        die('bridge 武装硬门: ' + why + '\n'
            f'  本席签名: {sig or "(无 — 未设 ORCH_SIG/MAESTRO_ORCH_SIGNATURE,亦无 bridge/orch.signature)"}\n'
            '  → arm 指引: 本会话内武装回调桥(bridge_arm;或 POST /register {"sessionId":"<本会话id>","alias":"<别名>"}'
            ',端口见 bridge/http.port),取得 <alias>@<sessionId> 回信签名后重试。\n'
            '  依据: --wait 阻塞等待已退役,回调是完成等待唯一手段(ADR-013 唤醒单车道)。',
            1)

    if not sig or '@' not in sig:
        refuse('本席签名不可得或缺 @sessionId —— 无回信地址不派工')
    sid = sig.rsplit('@', 1)[1].strip()
    try:
        with open(reg, encoding='utf-8') as f:
            consumers = (json.load(f).get('consumers') or {})
    except (OSError, json.JSONDecodeError, AttributeError) as e:
        refuse(f'bridge/registry.json 不可读({reg}: {e})—— 桥未武装')
    entry = consumers.get(sid)
    if not isinstance(entry, dict) or entry.get('stale'):
        refuse(f'本会话 {sid} 无在册 bridge consumer(stale或缺册)')

def _node_hit(r):
    refs, _warn = refs_as_dict(r[3])
    return {'project': r[0], 'node_id': r[1], 'status': r[2], 'refs': refs}

def find_dispatch_node(ref=None, task_id=None):
    """跨项目找 dispatch 节点: ref→node_id 精确;task_id→refs.task(LIKE 预滤+python 精核)。
    多命中取 updated_at 最新;无命中 None。"""
    try:
        c = read_only_db()
    except sqlite3.OperationalError as e:
        die(f'ledger.db 不可读: {e}', 5)
    try:
        if ref:
            rows = c.execute("SELECT project_key,node_id,status,refs FROM nodes "
                             "WHERE node_id=? AND kind='dispatch' ORDER BY updated_at DESC", (ref,)).fetchall()
            if rows:
                return _node_hit(rows[0])
        if task_id:
            cands = c.execute("SELECT project_key,node_id,status,refs FROM nodes "
                              "WHERE kind='dispatch' AND refs LIKE ? ORDER BY updated_at DESC",
                              (f'%{task_id}%',)).fetchall()
            for r in cands:
                hit = _node_hit(r)
                if hit['refs'].get('task') == task_id:
                    return hit
        return None
    finally:
        c.close()

def book_running(node, frame_from, note):
    """仅 dispatched 现态迁 running(node+ticket 环);已 running/end 等幂等跳过。"""
    nid, project, refs = node['node_id'], node['project'], node['refs'] or {}
    if node['status'] == 'running':
        return f'running 帧幂等跳过(已 running): {nid}'
    if node['status'] != 'dispatched':
        return f'running 帧跳过(现态 {node["status"]},晚帧不追): {nid}'
    node_transition(project, nid, 'running', 'running',
                    f'worker turn started | from={frame_from} | {note[:200]}')
    tref = refs.get('ref')
    if tref:
        row = get_ticket(tref)
        if row and row['state'] == 'dispatched':
            run_ledger(['ticket', 'state', tref, 'running', '--source', 'orch'])
    return f'running: {nid} (from={frame_from})'

def sweep_running_frames():
    """tail 增量消费 running.log(字节游标存 orch-running-cursor.json,原子推进);
    半行(写入中)留给下次;截断/轮转从头重扫(现态幂等兜底)。返回动作说明列表。"""
    results = []
    if not os.path.isfile(RUNNING_LOG):
        return results
    cur_map = _read_json(state_file('orch-running-cursor.json'), {})
    off = cur_map.get(RUNNING_LOG, 0)
    try:
        size = os.path.getsize(RUNNING_LOG)
    except OSError:
        return results
    if size < off:
        off = 0
    with open(RUNNING_LOG, 'rb') as f:
        f.seek(off)
        blob = f.read()
    if not blob:
        return results
    pieces = blob.split(b'\n')
    if blob.endswith(b'\n'):
        complete, processed = pieces[:-1], off + len(blob)
    else:
        complete = pieces[:-1]
        processed = off + (len(blob) - len(pieces[-1])) if pieces[:-1] else off
    sig = orch_sig()
    for raw in complete:
        try:
            fr = json.loads(raw.decode('utf-8', errors='replace'))
        except json.JSONDecodeError:
            continue
        if not isinstance(fr, dict) or fr.get('type') != 'ticket-running':
            continue
        to = fr.get('to')
        if to and (not sig or to != sig):
            if sig and to == sig.split('@')[0]:
                print(f'orch: WARN running 帧 to={to} 仅别名缺 @session(疑 hook 端 ORCH_SIG 未带全签名),未消费',
                      file=sys.stderr)
            continue   # 寻址不符(他人帧/半签帧)不消费
        ref = str(fr.get('ref') or '')
        m = re.search(r'\[task:([^\]\s]+)\]', fr.get('body') or '')
        node = None
        if ref and not ref.startswith('task_'):
            node = find_dispatch_node(ref=ref)
        if node is None:
            tid = ref if ref.startswith('task_') else (m.group(1) if m else '')
            if tid:
                node = find_dispatch_node(task_id=tid)
        if node is None:
            results.append(f'running 帧跳过(无匹配节点): ref={ref or "-"}')
            continue
        results.append(book_running(node, str(fr.get('from') or '-'),
                                    f'{fr.get("body") or ""} msgid={fr.get("msgid", "-")}'))
    if processed > off:
        cur_map[RUNNING_LOG] = processed
        _atomic_write_json(state_file('orch-running-cursor.json'), cur_map)
    return results

# ── node/ticket 迁移执行(先查现态,同态幂等) ──────────────────────────────────
def node_transition(project, node_id, to_status, event_type, detail, source='orch', auto_path=False):
    """node 状态机迁移: 查现态 → 校验 → ledger node upsert + event。
    auto_path=False(手工/_transition): 严格单边,表外即拒(状态机硬门)。
    auto_path=True(wait 收尾记账): 允许自动补中间态(worker_done 先于 running 观测到达时
    dispatched→running→end 补齐),每步均合法,事件只记目标一步;同态=幂等 no-op 零写。"""
    row = get_node(project, node_id)
    if not row:
        die(f'node 不存在: {node_id} @ {project}(先 orch dispatch 建账)', 1)
    cur = row['status']
    if cur == to_status:
        return f'noop({cur})'
    if auto_path:
        path = node_path(cur, to_status)
        if path is None:
            die(f"非法状态流转: {cur} -> {to_status}(状态机无路径)", 1)
    else:
        check_node_transition(cur, to_status)
        path = [to_status]
    for i, step in enumerate(path):
        run_ledger(['node', project, node_id, row['kind'], row['title'] or node_id, step,
                    '--owner', row['owner'] or '', '--refs', row['refs'] or '{}'])
        if i == len(path) - 1:
            run_ledger(['event', project, node_id, event_type, f'{cur} -> {to_status} | {detail}', '--source', source])
    return f'{cur} -> {to_status}'

def _transition_cmd(a):
    """内部显式迁移(自测/人工修复)。kind/title 取现行,不外泄写路径细节。"""
    row = get_node(a.project, a.node)
    if not row:
        die(f'node 不存在: {a.node} @ {a.project}', 1)
    res = node_transition(a.project, a.node, a.to, 'state', f'manual/_transition (source={a.source})', source=a.source)
    print(f'{a.node}: {res}')

def ticket_transition(tid, target, source='orch'):
    """ticket 状态机: 求最短合法路径逐步迁移;票不存在则跳过(返回 None)。"""
    row = get_ticket(tid)
    if row is None:
        return None
    path = ticket_path(row['state'], target)
    if path is None:
        die(f"ticket 状态机无路径: {tid} {row['state']} -> {target}", 1)
    for step in path:
        run_ledger(['ticket', 'state', tid, step, '--source', source])

# ── 终端发现(缺 --to 时给选择面) ──────────────────────────────────────────────
def list_connected_terminals():
    doc = orca_json(['terminal', 'list'], 'terminal list')
    items = doc if isinstance(doc, list) else find_key(doc, 'terminals') or []
    out = []
    for t in items:
        if not isinstance(t, dict):
            continue
        conn = t.get('connected', t.get('connected'))
        if conn is True or (isinstance(conn, str) and conn.lower() == 'true'):
            out.append({'id': t.get('id') or t.get('terminal') or t.get('handle'), 'title': t.get('title') or ''})
    return [t for t in out if t['id']]

def die_no_target():
    terms = list_connected_terminals()
    lines = '\n'.join(f"  {t['id']}  {t['title']}" for t in terms) or '  (无 connected 终端)'
    die(f'缺 --to 目标。活体 terminal(connected:true):\n{lines}\n→ orch dispatch --to <handle> ...', 64)

# ── 子命令: dispatch ─────────────────────────────────────────────────────────
def cmd_dispatch(a):
    bridge_arm_gate()   # ORCH-WAKE ②: 前置硬门,未武装拒绝(含 --dry-run;唯一豁免=selftest 走 ORCH_BRIDGE_REGISTRY 夹具)
    if a.spec == '-':
        spec = sys.stdin.read()
    else:
        try:
            with open(a.spec, encoding='utf-8') as f:
                spec = f.read()
        except OSError as e:
            die(f'--spec 不可读: {e}', 64)
    if not spec.strip():
        die('--spec 内容为空', 64)
    if not a.to and not a.dry_run:
        die_no_target()
    if bool(a.run) == bool(a.new_run):
        die('--run <run_id> 与 --new-run "<objective>" 二选一', 64)

    title = a.title or (a.ref or '').strip() or ' '.join(spec.strip().splitlines()[0].split())[:60] or 'orch task'

    # 1. run 绑定/创建
    if a.new_run:
        if a.dry_run:
            plan([orca_bin(), 'orchestration', 'run-create', '--objective', a.new_run, '--json'])
            run_id = '<run_id>'
        else:
            doc = orca_json(['orchestration', 'run-create', '--objective', a.new_run], 'run-create')
            run_id = (find_key(doc, 'runId', 'run_id', 'run') if isinstance(find_key(doc, 'runId', 'run_id', 'run'), str)
                      else find_prefixed(doc, 'run_'))
            if not run_id:
                die(f'run-create 输出无 run id: {json.dumps(doc, ensure_ascii=False)[:300]}', 5)
    else:
        run_id = a.run
        if a.dry_run:
            plan([orca_bin(), 'orchestration', 'run-use', '--id', run_id, '--json'])
        else:
            orca_json(['orchestration', 'run-use', '--id', run_id], 'run-use')

    # 2. task-create
    if a.dry_run:
        plan([orca_bin(), 'orchestration', 'task-create', '--spec', spec, '--task-title', title,
              '--run', run_id, '--json'])
        task_id = '<task_id>'
    else:
        doc = orca_json(['orchestration', 'task-create', '--spec', spec, '--task-title', title, '--run', run_id],
                        'task-create')
        task_id = (find_key(doc, 'taskId', 'task_id', 'task') if isinstance(find_key(doc, 'taskId', 'task_id', 'task'), str)
                   else find_prefixed(doc, 'task_'))
        if not task_id:
            die(f'task-create 输出无 task id: {json.dumps(doc, ensure_ascii=False)[:300]}', 5)

    # 3. dispatch --inject
    if a.dry_run:
        plan([orca_bin(), 'orchestration', 'dispatch', '--task', task_id, '--to', a.to or '<handle>',
              '--inject', '--json'])
        ctx = '<ctx_id>'
    else:
        doc = orca_json(['orchestration', 'dispatch', '--task', task_id, '--to', a.to, '--inject'], 'dispatch')
        ctx = (find_key(doc, 'dispatchId', 'dispatch_id', 'ctx', 'dispatch')
               if isinstance(find_key(doc, 'dispatchId', 'dispatch_id', 'ctx', 'dispatch'), str)
               else find_prefixed(doc, 'ctx_'))
        if not ctx:
            die(f'dispatch 输出无 ctx id: {json.dumps(doc, ensure_ascii=False)[:300]}', 5)

    if a.dry_run:
        sys.exit(0)

    # 4. ledger 自动建账(编排席规则7: 派发→node dispatched+事件;tickets 环勾稽 #11)
    project = a.project or os.getcwd()
    node_id = a.ref or task_id
    refs = {'run': run_id, 'task': task_id, 'dispatch': ctx, 'to': a.to}
    if a.ref:
        refs['ref'] = a.ref
    refs_json = json.dumps(refs, ensure_ascii=False)

    if resolve_project_key(project) is None:   # 项目未登记才补注册(幂等 upsert)
        run_ledger(['project', project, os.path.basename(str(project).rstrip('/')) or 'proj'])
    cur = get_node(project, node_id)
    duplicate = False
    if cur and cur['status'] not in NODE_TERMINAL:
        if not a.force:
            die(f"重复派发拒绝: node {node_id} 现态 {cur['status']}(--force 放行并记 duplicate)", 1)
        duplicate = True
    run_ledger(['node', project, node_id, 'dispatch', title, 'dispatched', '--owner', a.to or '', '--refs', refs_json])
    run_ledger(['event', project, node_id, 'dispatched',
                f'orch dispatch -> {a.to} ctx={ctx} run={run_id} task={task_id}'
                + (' | duplicate(--force)' if duplicate else ''),
                '--source', 'orch'])
    # tickets 环(#11): 票源=ledger.db tickets 表(PM-003),写它 pm-web 才更新
    ticket_note = ''
    if a.ref and not a.no_ticket:
        if not ticket_exists(a.ref):
            run_ledger(['ticket', 'add', a.ref, title, '--source', 'orch', '--refs', refs_json])
        run_ledger(['ticket', 'lease', a.ref, a.to, '--source', 'orch'])
        ticket_note = f'ticket {a.ref} +lease({a.to})'

    save_last_run({'run': run_id, 'project': project, 'node': node_id, 'ref': a.ref,
                   'task': task_id, 'ctx': ctx, 'to': a.to, 'title': title})
    summary = {'run': run_id, 'task': task_id, 'ctx': ctx, 'node': node_id,
               'project': project, 'to': a.to, 'duplicate': duplicate}
    if a.json:
        print(json.dumps(summary, ensure_ascii=False))
    else:
        print(f"dispatched: {node_id} -> {a.to} (run={run_id} task={task_id} ctx={ctx})"
              + (' [duplicate]' if duplicate else ''))
        if ticket_note:
            print(ticket_note)
        print('下一步: 完成等待=回调(worker_done 原生唤醒,ADR-013);收讫结算 orch settle --payload-file <delivery>')

# ── dag 族(ORCH-UNIFY 收编自 orch-dag;唯一入口=orch) ─────────────────────────
# 原子生命周期: dag-seat-open→dag-run→dag-task[--deps]→dag-seat→(回调)dag-settle→dag-close。
# 契约(承 orch-dag,审计 2cfc6b2 定谳语义原样保留): agent 固定 omp、worktree 固定
# new-top-level、tickets 环随生命周期强制勾稽、零模式旗标、缺参 fail-loud(argparse 层
# exit 2);deps 屏障三层=本地依赖未建拒绝 → Orca task_not_startable 硬拒绝透传 →
# ledger 票面 deps 未就绪拒迁 running/end。派发链四命令(dag-seat-open/run/task/seat)
# 同过 bridge 武装硬门(V3: 未武装拒派)。wait 已退役: 完成等待=回调(ADR-013),
# 收讫记账 dag-settle(票/node→running「复验待关账」),终态 dag-close(手工)。
DAG_AGENT = 'omp'                    # 硬编码: 唯一执行席 harness(审计③: 减少选择性,记录即可)
DAG_WORKTREE = 'new-top-level'       # 硬编码: 每票新顶层 worktree
DAG_SEAT_TITLE = 'ORCH-SEAT'

def dag_state_path():
    return os.environ.get('ORCH_DAG_STATE') or state_file('orch-dag.json')

def dag_load():
    s = _read_json(dag_state_path(), {})
    s.setdefault('seat', None)
    s.setdefault('run', None)
    s.setdefault('project', None)
    s.setdefault('refs', {})
    return s

def dag_save(s):
    _atomic_write_json(dag_state_path(), s)

def dag_need_seat(s):
    if not s.get('seat'):
        die('编排席未建: 先执行 orch dag-seat-open --project <path>', 64)
    return s['seat']

def _dag_doc_id(doc, what, *names, prefix):
    """orca-ide 返回形态双兼容归一(orch-dag 旧嵌套 result.run.id 与 orch 扁平 run=xx)。"""
    hit = find_key(doc, *names)
    if isinstance(hit, dict):
        hit = hit.get('id') or hit.get('dispatchId')
    if not isinstance(hit, str):
        hit = find_prefixed(doc, prefix)
    if not hit:
        die(f'{what} 输出无 id: {json.dumps(doc, ensure_ascii=False)[:300]}', 5)
    return hit

def dag_ticket_refs(ref):
    """从 ledger.db 只读票 refs(orca_task 等),供幂等纳管;票/表/库未建→None。
    (connect 失败与查询失败分离,同 get_ticket 修法。)"""
    try:
        c = read_only_db()
    except sqlite3.OperationalError:
        return None
    try:
        row = c.execute("SELECT refs FROM tickets WHERE ticket_id=?", (ref,)).fetchone()
    except sqlite3.OperationalError:
        return None
    finally:
        c.close()
    if not row:
        return None
    refs, _warn = refs_as_dict(row[0])
    return refs

def cmd_dag_seat_open(a):
    bridge_arm_gate()   # ORCH-UNIFY V3: 派发链全路径过武装门
    s = dag_load()
    if a.base_branch:   # dbdeb83 收编: worker-start 显式基点(repo 默认基点变更后的双保险)
        s['worker_base_ref'] = a.base_branch
    if s.get('seat'):
        if a.base_branch:
            dag_save(s)
            print(f"seat: 复用 {s['seat']}(worker_base_ref={a.base_branch})")
        else:
            print(f"seat: 复用 {s['seat']}")
        return
    project = os.path.abspath(a.project)
    doc = orca_json(['worktree', 'list'], 'worktree list')
    wl = find_key(doc, 'worktrees')
    wid = None
    for w in (wl if isinstance(wl, list) else []):
        if isinstance(w, dict) and (w.get('path') or '') == project:
            wid = w.get('id')
            break
    if not wid:
        die(f'project 不在 Orca 树: {project}(先 orca worktree 注册)', 5)
    tl = orca_json(['terminal', 'create', '--worktree', f'id:{wid}', '--title', a.title],
                   '编排席终端创建')
    t = find_key(tl, 'terminal')
    t = t if isinstance(t, dict) else {}
    handle = t.get('handle') or t.get('id')
    if not handle:
        die(f'编排席终端无 handle: {json.dumps(tl, ensure_ascii=False)[:300]}', 5)
    s['seat'] = handle
    s['project'] = project
    dag_save(s)
    print(f'seat: {handle}')

def cmd_dag_run(a):
    bridge_arm_gate()
    s = dag_load()
    seat = dag_need_seat(s)
    if s.get('run'):
        print(f"run: 复用 {s['run']}")
        return
    doc = orca_json(['orchestration', 'run-create', '--from', seat, '--objective', a.objective],
                    'run-create')
    rid = _dag_doc_id(doc, 'run-create', 'runId', 'run_id', 'run', prefix='run_')
    s['run'] = rid
    dag_save(s)
    print(f'run: {rid}')

def cmd_dag_task(a):
    bridge_arm_gate(getattr(a, 'orch_sig', None))   # SIG-MANDATE: 显式签名优先过门(检 caller 真身)
    s = dag_load()
    seat = dag_need_seat(s)
    if not s.get('run'):
        die('Run 未建: 先执行 orch dag-run "<objective>"', 64)
    if a.ref in s['refs'] and s['refs'][a.ref].get('orca_task'):
        print(f"task: 复用 {a.ref} -> {s['refs'][a.ref]['orca_task']}")
        return
    existing = dag_ticket_refs(a.ref)
    if existing and existing.get('orca_task'):
        s['refs'][a.ref] = {'orca_task': existing['orca_task'], 'ticket': True}
        dag_save(s)
        print(f"task: 纳管 {a.ref} -> {existing['orca_task']}")
        return
    deps = [d.strip() for d in (a.deps or '').split(',') if d.strip()]
    for d in deps:   # deps 屏障第一层: 本地依赖未建 fail-loud(不推断)
        if d not in s['refs'] or not s['refs'][d].get('orca_task'):
            die(f'依赖 ref 未建 task: {d}(先 orch dag-task {d})—— deps 硬屏障(本地层)', 1)
    bad = [d for d in deps if not ticket_exists(d)]   # CONTRACT-HYGIENE 建票前预校验: 票号必须 ledger 已在(杜绝 R41/R42 式双前缀写账伪影);
    if bad:   # ticket_exists 即 #133 同族已修安全助手(connect/查询分离,无 UnboundLocalError);先于 task-create 与 ticket add,exit 2 零落票
        die(f'deps 票号 ledger 不可解析: {", ".join(bad)}'
            f'(先 orch dag-task 建齐依赖,或修正票号后重建)—— 建票前预校验 fail-loud,零落票: {a.ref}', 2)
    dep_ids = [s['refs'][d]['orca_task'] for d in deps]
    sig = dag_orch_sig(a.orch_sig, s)
    spec = dag_envelope(sig, a.ref) + '\n' + a.spec   # HOOK-ENVELOPE: 信封必须首行,任务书正文原样跟随
    args = ['orchestration', 'task-create', '--from', seat, '--task-title', a.title, '--spec', spec]
    if dep_ids:
        args += ['--deps', json.dumps(dep_ids)]   # 第二层: Orca task_not_startable 硬拒绝透传
    doc = orca_json(args, f'task-create({a.ref})')
    tid = _dag_doc_id(doc, f'task-create({a.ref})', 'taskId', 'task_id', 'task', prefix='task_')
    cwd = s.get('project') or ''
    if not cwd:   # 341a100 语义保持: 建票强制 cwd(pm-web 票板按 refs.cwd 分组)
        die('project 未记录: 先执行 orch dag-seat-open --project(pm-web 票板按 refs.cwd 分组,缺 cwd 进折叠池)', 1)
    run_ledger(['ticket', 'add', a.ref, a.title,
                '--deps', json.dumps(deps),
                '--refs', json.dumps({'run': s['run'], 'orca_task': tid, 'seat': seat, 'cwd': cwd},
                                     ensure_ascii=False),
                '--source', 'orch-dag'], f'ticket add 失败({a.ref})')
    s['refs'][a.ref] = {'orca_task': tid, 'ticket': True}
    dag_save(s)
    print(f'task: {a.ref} -> {tid} (信封首行 from={sig})')

def dag_ensure_project(project):
    """项目未登记才补注册(幂等 upsert,同 cmd_dispatch 派发路径;账本空库自举)。"""
    if resolve_project_key(project) is None:
        run_ledger(['project', project, os.path.basename(str(project).rstrip('/')) or 'proj'])

def dag_orch_sig(flag, state=None):
    """SIG-MANDATE(issue#1,用户裁决): 席位/信封签名=显式必传(--orch-sig 旗标或 env ORCH_SIG),
    零静默回落——多席共册下 seat 落态(末写者胜)/bridge 签名文件/orch-p0 字面兜底皆他人签名
    错绑源(orch-e2e E2E 实证:dag-seat 漏传解析到 orch1 落态)。缺席 die(2) 附本席签名获取法。
    state 形参保留兼容旧调用,不再参与解析。"""
    sig = (flag or '').strip() or os.environ.get('ORCH_SIG', '').strip()
    if not sig:
        die('--orch-sig 必传(SIG-MANDATE): 签名零静默回落,防多席错绑。'
            '本席签名获取法: dsh 席=echo $DSH_SESSION_ID;任意面=bridge_arm 后查 '
            '~/.dsh/maestro/bridge/registry.json 自己的注册行(<别名>@<sessionId>)。'
            '传法: --orch-sig <签名> 或 export ORCH_SIG=<签名>', 2)
    return sig


def dag_envelope(sig, ref):
    """DSHMSG 派票信封(HOOK-ENVELOPE A′): 必须落 task 文本首行(消费端 ups 钩
    awk NR==1 只认首行)。to='-'(worker 签名派发时不可知,消费端只取 from/ref/msgid);
    type=dispatch;ref=票 REF;msgid 唯一(uuid4);ver=3。"""
    return 'DSHMSG]' + json.dumps(
        {'from': sig, 'to': '-', 'type': 'dispatch', 'ref': ref or 'dispatch',
         'msgid': str(uuid.uuid4()), 'ver': 3}, ensure_ascii=False)


def cmd_dag_seat(a):
    bridge_arm_gate(getattr(a, 'orch_sig', None))   # SIG-MANDATE: 显式签名优先过门
    s = dag_load()
    seat = dag_need_seat(s)
    if not s.get('project'):
        die('project 未记录: 先执行 orch dag-seat-open --project', 64)
    if a.ref not in s['refs'] or not s['refs'][a.ref].get('orca_task'):
        die(f"ref 未建 task: {a.ref}(先 orch dag-task {a.ref})", 64)
    tid = s['refs'][a.ref]['orca_task']
    if a.orch_sig:   # SIG-MANDATE(issue#1): 席位级签名仅簿记展示,不再参与 dag-task 解析(末写者胜错绑源)
        s['orch_sig'] = a.orch_sig.strip()
        dag_save(s)
    name = a.name or a.ref.lower()
    ws_args = ['orchestration', 'worker-start', '--from', seat, '--task', tid,
               '--worktree', DAG_WORKTREE, '--name', name, '--agent', DAG_AGENT]
    if s.get('worker_base_ref'):   # dbdeb83 收编: 显式基点双保险
        ws_args += ['--base-branch', s['worker_base_ref']]
    doc = orca_json(ws_args, f'worker-start({a.ref})')
    ctx = _dag_doc_id(doc, f'worker-start({a.ref})', 'dispatchId', 'dispatch_id', 'dispatch', prefix='ctx_')
    dag_ensure_project(s['project'])   # 账本空库自举: node 写路径要求项目在册(ledger resolve_project fail-loud)
    run_ledger(['ticket', 'refs-set', a.ref, '--json',
                json.dumps({'dispatch': ctx, 'worktree': name, 'agent': DAG_AGENT}, ensure_ascii=False)],
               f'ticket refs-set 失败({a.ref})')
    run_ledger(['node', s['project'], a.ref, 'dispatch', f'R-ticket {a.ref} {DAG_AGENT} 席位派发',
                'dispatched', '--refs',
                json.dumps({'run': s['run'], 'orca_task': tid, 'dispatch': ctx}, ensure_ascii=False)],
               f'ledger node 失败({a.ref})')
    print(f'seat: {a.ref} dispatched dispatch={ctx}'
          + (f" orch_sig={s['orch_sig']}" if s.get('orch_sig') else ''))

def cmd_dag_settle(a):
    """worker_done 回调收讫(ADR-013 单车道): 票/node → running「复验待关账」。
    --dispatch 给出时顺带 worker-release(Orca 原生 worker_done 场景)。
    幂等: 已 running 及之后现态跳过;ledger 票面 deps 未就绪拒迁 → fail-loud(屏障第三层)。"""
    for line in sweep_running_frames():
        print(f'orch: {line}', file=sys.stderr)
    row = get_ticket(a.ref)
    if row is None:
        die(f'票不存在: {a.ref}(dag 族票以 ref 为 ticket_id,先 orch dag-task)', 1)
    if row['state'] in ('dispatched', 'blocked'):
        run_ledger(['ticket', 'state', a.ref, 'running', '--source', 'orch-dag',
                    '--note', 'worker_done 收讫,复验待关账(dag-close 才终态)'],
                   f'ticket→running 失败({a.ref})')
    else:
        print(f"settle: 票 {a.ref} 现态 {row['state']},幂等跳过(非 dispatched/blocked)")
    project = dag_load().get('project') or os.getcwd()
    node = get_node(project, a.ref)
    if node and node['status'] in ('dispatched', 'blocked'):
        try:
            node_transition(project, a.ref, 'running', 'worker_done', (a.outcome or '回调收讫')[:300],
                            source='orch-dag', auto_path=True)
        except SystemExit as e:
            print(f'orch: WARN node 记账跳过({e.code}): {a.ref}', file=sys.stderr)
    if a.dispatch:
        rc, _, err = run_orca(['orchestration', 'worker-release', '--dispatch', a.dispatch])
        if rc != 0:
            print(f'orch: WARN worker-release 失败(rc={rc}): {(err or "").strip()[:200]}(账已记 running)',
                  file=sys.stderr)
    print(f'settle: {a.ref} → running(复验待关账) outcome={(a.outcome or "")[:80]}')

def cmd_dag_close(a):
    """复验后关账(唯一终态入口,手工): ticket 终态 + node 合法同步 + closed 事件。
    rejected/rolled-back 为票面语义,node 只记事件(node 状态机无此二态)。"""
    if a.state == 'done':
        a.state = 'end'   # END-RENAME: done=旧别名(存量肌肉记忆),语义同 end
    if a.state not in ('end', 'rejected', 'rolled-back', 'blocked'):
        die('close 仅接受 end|rejected|rolled-back|blocked(done 旧别名兼容)', 64)
    t = get_ticket(a.ref)
    if t is None:
        die(f'票不存在: {a.ref}', 1)
    if t['state'] == a.state:   # P2(模拟E2E 缺口,2026-09-10): 同态重放幂等跳过(仿 S23 settle 先例),end→end 重跑不再非法
        print(f'close: {a.ref} 幂等跳过(已 {a.state})')
        return
    run_ledger(['ticket', 'state', a.ref, a.state, '--source', 'orch-dag',
                '--note', (a.outcome or '')[:300]], f'ticket close 失败({a.ref})')
    project = dag_load().get('project') or os.getcwd()
    node = get_node(project, a.ref)
    node_map = {'end': 'end', 'blocked': 'blocked'}
    if node and a.state in node_map and node['status'] not in NODE_TERMINAL:
        try:
            node_transition(project, a.ref, node_map[a.state], f'closed-{a.state}',
                            (a.outcome or '')[:300], source='orch-dag', auto_path=True)
        except SystemExit as e:
            print(f'orch: WARN node 记账跳过({e.code}): {a.ref}', file=sys.stderr)
    dag_ensure_project(project)   # 账本空库自举: closed 事件要求项目在册
    run_ledger(['event', project, a.ref, f'closed-{a.state}', (a.outcome or '')[:300],
                '--source', 'orch-dag'], f'event 失败({a.ref})')
    print(f'close: {a.ref} -> {a.state}')

def cmd_dag_status(a):
    for line in sweep_running_frames():
        print(f'orch: {line}', file=sys.stderr)
    s = dag_load()
    doc = {'seat': s.get('seat'), 'run': s.get('run'), 'project': s.get('project'),
           'refs': {k: v.get('orca_task') for k, v in s.get('refs', {}).items()}}
    if a.json:
        print(json.dumps(doc, ensure_ascii=False))
    else:
        print(json.dumps(doc, ensure_ascii=False, indent=1))
    if s.get('run') and s.get('seat'):
        out = orca_json(['orchestration', 'task-list', '--from', s['seat']], 'task-list')
        tasks = find_key(out, 'tasks')
        for t in (tasks if isinstance(tasks, list) else []):
            if isinstance(t, dict):
                print(f"  {t.get('id')} {str(t.get('status')):10} "
                      f"{t.get('task_title') or t.get('display_name') or ''}"[:110])

# ── 子命令: wait ─────────────────────────────────────────────────────────────
def settle_node(project, node_id, to_status, event_type, detail):
    """收果记账(规则8): node 迁移(自动补 running 中间态已由路径求导覆盖 node 侧表)+
    ≤300字 outcome 事件。node 迁移被拒(如终态后再收果) → WARN 跳过,不阻塞 ack/release。"""
    try:
        res = node_transition(project, node_id, to_status, event_type, detail[:300], auto_path=True)
        return res
    except SystemExit as e:
        print(f'orch: WARN ledger node 记账跳过({e.code}): {node_id}', file=sys.stderr)
        return None

def resolve_settle_target(a):
    """settle 收讫对象解析: --run/--project 显式优先,缺省 last-run 指针 → refs 兜底。"""
    run = a.run
    rec = None
    if not run:
        rec = load_last_run()
        if not rec or not rec.get('run'):
            die('缺 --run 且无 last-run 记录(先 orch dispatch,或显式 --run)', 64)
        run = rec['run']
    project, node_id, ref = a.project, None, None
    if not project:
        if rec and rec.get('project'):
            project, node_id, ref = rec['project'], rec.get('node'), rec.get('ref')
        else:
            hit = find_node_by_run(run)
            if hit:
                project, node_id = hit['project'], hit['node_id']
                ref = (hit.get('refs') or {}).get('ref')
    if not project:
        project = os.getcwd()
    if node_id and not get_node(project, node_id):
        node_id = None   # last-run 指向的节点已被清库等: 退化为按 refs 兜底
    if not node_id:
        hit = find_node_by_run(run)
        if hit:
            project, node_id = hit['project'], hit['node_id']
            ref = ref or (hit.get('refs') or {}).get('ref')
    return run, project, node_id, ref

def settle_message(msg, run, project, node_id, ref, top_delivery):
    """单条消息收尾。次序硬约定: 先 ledger 记账(失败 exit5,orca 侧未动,可整链重放)
    → 再 ack(fail-loud) → release(WARN) → 记幂等账(deliveryId)。
    返回 (action, exit_code_contrib)。action ∈ end|escalation|question|status|skip。"""
    mtype = (msg.get('type') or '').strip()
    delivery_id = top_delivery or find_delivery_id(msg) or (str(msg['id']) if msg.get('id') else '')
    payload = msg_payload_dict(msg)
    ctx = payload.get('dispatchId') or payload.get('dispatch') or (load_last_run() or {}).get('ctx')
    outcome = str(payload.get('outcome') or msg.get('subject') or '')[:300]

    if delivery_id and delivery_seen(run, delivery_id):
        print(f'already settled, skip: {delivery_id} ({mtype})')
        return ('skip', 0)

    if mtype == 'worker_done':
        if project and node_id:
            settle_node(project, node_id, 'end', 'worker_done', outcome or f'delivery={delivery_id}')
        if ref:
            ticket_transition(ref, 'end')
            if get_ticket(ref) and get_ticket(ref)['lease_owner']:
                run_ledger(['ticket', 'lease', ref, '--release', '--source', 'orch'])
        if delivery_id:
            orca_json(['orchestration', 'check', '--ack', delivery_id, '--run', run],
                      f'check --ack {delivery_id}')
        if ctx:
            rc, _, err = run_orca(['orchestration', 'worker-release', '--dispatch', ctx])
            if rc != 0:
                print(f'orch: WARN worker-release 失败(rc={rc}): {(err or "").strip()[:200]}(账已记 end)', file=sys.stderr)
        if delivery_id:
            record_delivery(run, delivery_id, mtype, outcome)
        print(f"worker_done 收口: node={'end' if node_id else '?'} delivery={delivery_id} outcome={outcome[:80]}")
        return ('end', 0)

    if mtype == 'escalation':
        if project and node_id:
            settle_node(project, node_id, 'blocked', 'escalation', outcome or f'delivery={delivery_id}')
        if ref:
            ticket_transition(ref, 'blocked')
        if delivery_id:
            orca_json(['orchestration', 'check', '--ack', delivery_id, '--run', run],
                      f'check --ack {delivery_id}')
        if ctx:
            run_orca(['orchestration', 'worker-release', '--dispatch', ctx])
        if delivery_id:
            record_delivery(run, delivery_id, mtype, outcome)
        print(f'escalation: 已 ack+release, node=blocked, 需编排席介入. outcome={outcome[:80]}')
        return ('escalation', 3)

    if mtype == 'question':
        # 不动 orca 侧(不 ack 不 release,等编排席裁决);只记账 blocked
        if project and node_id:
            settle_node(project, node_id, 'blocked', 'question', outcome or msg.get('subject') or '')
        if ref:
            ticket_transition(ref, 'blocked')
        msg_id = msg.get('id') or ''
        print(f'question 待裁决: msg_id={msg_id}')
        print(f'  应答: orch reply --msg {msg_id} --body "<text>" --run {run}')
        print('  应答后剩余完成信号仍走回调(worker_done 原生唤醒),无需轮询')
        return ('question', 2)

    # status/heartbeat/未知类型: ack 即可,不动账
    if delivery_id:
        rc, _, err = run_orca(['orchestration', 'check', '--ack', delivery_id, '--run', run])
        if rc != 0:
            print(f'orch: WARN ack 失败(rc={rc}): {(err or "").strip()[:200]}', file=sys.stderr)
        else:
            record_delivery(run, delivery_id, mtype, outcome)
    print(f'{mtype or "unknown"}: ack, 账不动')
    return ('status', 0)

def cmd_settle(a):
    """回调收讫结算(非阻塞,ADR-013 单车道): 完成信号=回调唤醒本席回合,唤醒携带的
    delivery 文档(ex-阻塞 check 输出形态 {"deliveryId":..,"messages":[..]})经
    --payload-file/--payload/- 传入,逐条 settle(ack/release/记账)。
    退出码随消息类型: worker_done 0 / question 2 / escalation 3。"""
    if a.payload_file and a.payload is not None:
        die('--payload-file 与 --payload 二选一', 64)
    if a.payload_file:
        try:
            with open(a.payload_file, encoding='utf-8') as f:
                blob = f.read()
        except OSError as e:
            die(f'--payload-file 不可读: {e}', 64)
    elif a.payload == '-':
        blob = sys.stdin.read()
    elif a.payload:
        blob = a.payload
    else:
        die('缺 --payload-file/--payload(回调唤醒应携带 delivery 文档;阻塞拉取已退役)', 64)
    if not blob.strip():
        die('payload 为空(无可结算;完成信号本体=回调,不轮询)', 64)
    run, project, node_id, ref = resolve_settle_target(a)
    for line in sweep_running_frames():   # 进门先收 running 帧(hook sidecar)
        print(f'orch: {line}', file=sys.stderr)
    try:
        doc = json.loads(blob)
    except json.JSONDecodeError:
        die('payload 非 JSON(期待 {"deliveryId":..,"messages":[..]} 形态)', 64)
    delivery_id = find_delivery_id(doc)
    messages = find_messages(doc)
    if not messages:
        die(f'delivery={delivery_id or "?"} 无消息,无可结算', 64)
    worst, actions = 0, []
    for msg in messages:
        action, code = settle_message(msg, run, project, node_id, ref, delivery_id)
        actions.append(action)
        worst = max(worst, code)
    if a.json:
        print(json.dumps({'run': run, 'delivery': delivery_id, 'actions': actions, 'exit': worst,
                          'project': project, 'node': node_id}, ensure_ascii=False))
    sys.exit(worst)

# ── 子命令: reply ────────────────────────────────────────────────────────────
def cmd_reply(a):
    if bool(a.body) == bool(a.body_file):
        die('--body <text> 与 --body-file <f> 二选一', 64)
    body = a.body
    if a.body_file:
        try:
            with open(a.body_file, encoding='utf-8') as f:
                body = f.read()
        except OSError as e:
            die(f'--body-file 不可读: {e}', 64)
    run = a.run
    if not run:
        rec = load_last_run()
        if not rec or not rec.get('run'):
            die('缺 --run 且无 last-run 记录', 64)
        run = rec['run']
    if a.dry_run:
        plan([orca_bin(), 'orchestration', 'reply', '--id', a.msg, '--body', body, '--run', run, '--json'])
        return
    orca_json(['orchestration', 'reply', '--id', a.msg, '--body', body, '--run', run], 'reply')
    print(f'replied: {a.msg} (run={run})')
    print('后续完成信号仍走回调(worker_done 原生唤醒),无需重挂轮询')

# ── 子命令: status(离线合并视图: node 生命周期 + refs(run/task/ctx) 并排) ─────
def cmd_status(a):
    for line in sweep_running_frames():   # 只读视图也顺手收 running 帧(幂等合法流转)
        print(f'orch: {line}', file=sys.stderr)
    project = a.project or os.getcwd()
    key = resolve_project_key(project)
    rows = []
    if key:
        try:
            c = read_only_db()
            sql = ("SELECT node_id,kind,title,status,owner,refs,updated_at FROM nodes "
                   "WHERE project_key=?")
            params = [key]
            if a.ref:
                sql += ' AND node_id=?'
                params.append(a.ref)
            sql += ' ORDER BY updated_at DESC'
            rows = c.execute(sql, params).fetchall()
            evmap = {}
            for nid, in c.execute("SELECT DISTINCT node_id FROM events WHERE project_key=?", (key,)):
                evmap[nid] = c.execute(
                    "SELECT ts,event_type,detail FROM events WHERE project_key=? AND node_id=? ORDER BY id DESC LIMIT 3",
                    (key, nid)).fetchall()
        except sqlite3.OperationalError as e:
            die(f'ledger.db 读失败: {e}', 5)
        finally:
            c.close()
    out, shown = [], 0
    last = load_last_run()
    for r in rows:
        node_id, kind, title, status, owner, refs_raw, updated = r
        refs, rwarn = refs_as_dict(refs_raw)   # list/标量/坏JSON 归一 {} + WARN,绝不崩
        if a.run and refs.get('run') != a.run:
            continue
        shown += 1
        if a.json:
            out.append({'node': node_id, 'kind': kind, 'status': status, 'owner': owner,
                        'title': title, 'updated_at': updated, 'refs': refs,
                        'refs_warn': rwarn,
                        'events': [{'ts': e[0], 'type': e[1], 'detail': e[2]} for e in evmap.get(node_id, [])]})
        else:
            print(f"{status:<12} {node_id:<20} {kind:<9} owner={owner or '—'} {updated}")
            print(f"  title: {title or '—'}")
            if rwarn:
                print(f"orch: WARN {node_id}: {rwarn}(原样: {str(refs_raw)[:80]})", file=sys.stderr)
            print(f"  refs : run={refs.get('run', '—')} task={refs.get('task', '—')} "
                  f"ctx={refs.get('dispatch', '—')} to={refs.get('to', '—')}"
                  + (" [!异常形态,见 WARN]" if rwarn else ''))
            if last and last.get('node') == node_id:
                print(f"  last-run 指针: run={last.get('run')} ctx={last.get('ctx')} to={last.get('to')}")
            for e in evmap.get(node_id, []):
                print(f"  · [{e[0][5:16]}] {e[1]}: {str(e[2])[:90]}")
    if not shown:
        print(f'(无匹配节点: project={project}' + (f' run={a.run}' if a.run else '') + (f' ref={a.ref}' if a.ref else '') + ')')
        if last:
            print(f"last-run 指针: run={last.get('run')} node={last.get('node')} project={last.get('project')}")
    if a.json:
        print(json.dumps(out, ensure_ascii=False))

# ── 子命令: selftest(离线全链走查,fake ORCH_BIN stub,零实弹) ─────────────────
SELFTEST_STUB = r'''#!/usr/bin/env python3
import json, os, sys
argv = sys.argv[1:]
log = os.environ['ORCH_FAKE_LOG']
with open(log, 'a') as f:
    f.write(json.dumps(argv, ensure_ascii=False) + '\n')
def out(doc):
    print(json.dumps(doc, ensure_ascii=False))
if argv[:2] == ['terminal', 'list']:
    out({'terminals': [{'id': 'term_a', 'title': 'A', 'connected': True},
                       {'id': 'term_b', 'title': 'B', 'connected': False}]})
elif argv[:2] == ['orchestration', 'run-create']:
    n = open(os.environ['ORCH_FAKE_SEQ']).read().strip() or '0'
    open(os.environ['ORCH_FAKE_SEQ'], 'w').write(str(int(n) + 1))
    rid = f'run_fake{n}'
    out({'run': rid, 'runId': rid, 'id': rid, 'objective': 'x'})
elif argv[:2] == ['orchestration', 'run-use']:
    rid = argv[argv.index('--id') + 1]
    out({'ok': True, 'run': rid})
elif argv[:2] == ['orchestration', 'task-create']:
    n = open(os.environ['ORCH_FAKE_SEQ']).read().strip() or '0'
    open(os.environ['ORCH_FAKE_SEQ'], 'w').write(str(int(n) + 1))
    tid = f'task_fake{n}'
    out({'task': tid, 'taskId': tid, 'id': tid})
elif argv[:2] == ['orchestration', 'dispatch']:
    n = open(os.environ['ORCH_FAKE_SEQ']).read().strip() or '0'
    open(os.environ['ORCH_FAKE_SEQ'], 'w').write(str(int(n) + 1))
    cid = f'ctx_fake{n}'
    out({'ctx': cid, 'dispatchId': cid, 'injected': True})
elif argv[:1] == ['worktree'] and argv[1:2] == ['list']:
    out({'ok': True, 'result': {'worktrees': [{'id': 'wt_fake', 'path': os.environ.get('ORCH_FAKE_WTPATH', '/nonexistent')}]}})
elif argv[:1] == ['terminal'] and argv[1:2] == ['create']:
    out({'ok': True, 'result': {'terminal': {'handle': 'term_seat', 'id': 'term_seat'}}})
elif argv[:2] == ['orchestration', 'worker-start']:
    n = open(os.environ['ORCH_FAKE_SEQ']).read().strip() or '0'
    open(os.environ['ORCH_FAKE_SEQ'], 'w').write(str(int(n) + 1))
    cid = f'ctx_dag{n}'
    out({'ok': True, 'result': {'dispatch': {'id': cid}}, 'dispatchId': cid})
elif argv[:2] == ['orchestration', 'task-list']:
    out({'ok': True, 'result': {'tasks': []}})
elif argv[:2] == ['orchestration', 'check'] and '--ack' in argv:
    with open(os.environ['ORCH_FAKE_ACKS'], 'a') as f:
        f.write(argv[argv.index('--ack') + 1] + '\n')
    out({'ok': True})
elif argv[:2] == ['orchestration', 'worker-release']:
    with open(os.environ['ORCH_FAKE_RELEASES'], 'a') as f:
        f.write(argv[argv.index('--dispatch') + 1] + '\n')
    out({'ok': True})
elif argv[:2] == ['orchestration', 'reply']:
    with open(os.environ['ORCH_FAKE_REPLIES'], 'a') as f:
        f.write(json.dumps({'id': argv[argv.index('--id') + 1], 'run': argv[argv.index('--run') + 1]}) + '\n')
    out({'ok': True})
else:
    sys.stderr.write('fake-orca: 未模拟: ' + ' '.join(argv) + '\n')
    sys.exit(9)
'''

class Case:
    def __init__(self):
        self.n_pass = 0
        self.n_fail = 0
    def check(self, name, cond, hint=''):
        tag = 'PASS' if cond else 'FAIL'
        print(f'  [{tag}] {name}' + (f' — {hint}' if hint and not cond else ''))
        if cond:
            self.n_pass += 1
        else:
            self.n_fail += 1
        return cond

def _orch(args, env, cwd=None):
    p = subprocess.run([sys.executable, os.path.abspath(__file__), *args],
                       capture_output=True, text=True, timeout=120, env=env, cwd=cwd)
    return p

def cmd_selftest(a):
    global DB   # 父进程断言用例(get_node/get_ticket)必须与子进程同库,防误读真账
    import shutil
    tmp = tempfile.mkdtemp(prefix='orch-selftest-')
    c = Case()
    print(f'== orch selftest(离线,零实弹) sandbox={tmp}')
    try:
        # 环境隔离: fake orca + 独立 ledger.db + 独立 state
        bindir = os.path.join(tmp, 'bin')
        os.makedirs(bindir)
        stub = os.path.join(bindir, 'fake-orca')
        with open(stub, 'w') as f:
            f.write(SELFTEST_STUB)
        os.chmod(stub, 0o755)
        db = os.path.join(tmp, 'ledger.db')
        # 生产 schema 镜像(只建表不落数据;ledger 写路径所需)
        con = sqlite3.connect(db)
        con.executescript("""
          CREATE TABLE IF NOT EXISTS projects(
            key TEXT PRIMARY KEY, name TEXT NOT NULL, path TEXT NOT NULL,
            repo_id TEXT, status TEXT NOT NULL DEFAULT 'unknown', summary TEXT, updated_at TEXT NOT NULL);
          CREATE TABLE IF NOT EXISTS nodes(
            id INTEGER PRIMARY KEY AUTOINCREMENT, project_key TEXT NOT NULL, node_id TEXT NOT NULL,
            kind TEXT NOT NULL, title TEXT, status TEXT NOT NULL DEFAULT 'pending', owner TEXT,
            refs TEXT, updated_at TEXT NOT NULL, UNIQUE(project_key, node_id));
          CREATE TABLE IF NOT EXISTS events(
            id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT NOT NULL, project_key TEXT,
            node_id TEXT, event_type TEXT NOT NULL, source TEXT, detail TEXT);
        """)
        con.commit()
        con.close()
        DB = db
        proj = os.path.join(tmp, 'proj')
        os.makedirs(proj)
        with open(os.path.join(proj, 'spec.md'), 'w') as f:
            f.write('实现某功能\n细节若干行\n')
        runlog = os.path.join(tmp, 'running.log')
        open(runlog, 'w').close()
        env = dict(os.environ)
        env.update(ORCH_BIN=stub, MAESTRO_LEDGER=db, ORCH_STATE_DIR=os.path.join(tmp, 'state'),
                   ORCH_RUNNING_LOG=runlog, ORCH_SIG='test-orch@test-session',
                   ORCH_FAKE_LOG=os.path.join(tmp, 'calls.log'), ORCH_FAKE_SEQ=os.path.join(tmp, 'seq'),
                   ORCH_FAKE_ACKS=os.path.join(tmp, 'acks.log'), ORCH_FAKE_RELEASES=os.path.join(tmp, 'releases.log'),
                   ORCH_FAKE_REPLIES=os.path.join(tmp, 'replies.log'))
        open(env['ORCH_FAKE_SEQ'], 'w').write('0')
        # bridge 武装硬门夹具(ORCH-WAKE ②): 在册 consumer=ORCH_SIG 的 session 段
        breg = os.path.join(tmp, 'bridge-registry.json')
        with open(breg, 'w') as f:
            json.dump({'version': '4.1.0',
                       'consumers': {'test-session': {'alias': 'test-orch', 'pid': os.getpid(), 'armedAt': now()},
                                     # SIG-MANDATE: S21e 显式 --orch-sig 覆盖案的信封 from 席亦须在册(门检 caller 真身)
                                     'session-alt': {'alias': 'alt-orch', 'pid': os.getpid(), 'armedAt': now()}}}, f)
        env['ORCH_BRIDGE_REGISTRY'] = breg

        def calls():
            try:
                return [json.loads(l) for l in open(env['ORCH_FAKE_LOG'])]
            except FileNotFoundError:
                return []
        def resetspy():
            for f in ('ORCH_FAKE_LOG', 'ORCH_FAKE_ACKS', 'ORCH_FAKE_RELEASES', 'ORCH_FAKE_REPLIES'):
                if os.path.exists(env[f]):
                    os.unlink(env[f])

        def delivery(messages, delivery_id):
            fx = os.path.join(tmp, f'dlv-{delivery_id}.json')
            with open(fx, 'w') as f:
                json.dump({'deliveryId': delivery_id, 'messages': messages}, f, ensure_ascii=False)
            return fx

        # S1 dispatch 全链建账
        resetspy()
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a',
                   '--new-run', '做某事', '--ref', 'T-001', '--project', proj, '--json'], env, cwd=proj)
        ok = p.returncode == 0
        c.check('S1 dispatch 全链 rc=0', ok, p.stderr)
        try:
            s = json.loads(p.stdout.strip().splitlines()[-1])
        except Exception:
            s = {}
        c.check('S1 摘要含 run/task/ctx', s.get('run', '').startswith('run_fake')
                and s.get('task', '').startswith('task_fake') and s.get('ctx', '').startswith('ctx_fake'), p.stdout)
        node = get_node(proj, 'T-001')
        refs_ok = all((json.loads(node['refs'] or '{}')).get(k)
                      for k in ('run', 'task', 'dispatch', 'to')) if node else False
        c.check('S1 node dispatched+refs 全量', bool(node) and node['status'] == 'dispatched' and refs_ok,
                json.dumps(node, ensure_ascii=False))
        c.check('S1 ticket add+lease', get_ticket('T-001') == {'state': 'dispatched', 'lease_owner': 'term_a'},
                str(get_ticket('T-001')))
        c.check('S1 orca 链序 run→task→dispatch', [x[:2] for x in calls()].count(['orchestration', 'run-create']) == 1
                and [x[:2] for x in calls()].count(['orchestration', 'task-create']) == 1
                and [x[:2] for x in calls()].count(['orchestration', 'dispatch']) == 1, str(calls()))

        # S2 缺 --to → 列活体并拒
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--new-run', 'x', '--project', proj], env)
        c.check('S2 缺 --to 拒绝 exit=64 且列出 term_a', p.returncode == 64 and 'term_a' in p.stderr, p.stderr)

        # S3 重复 dispatch 拒 / --force 放
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a', '--run', s['run'],
                   '--ref', 'T-001', '--project', proj], env)
        c.check('S3 重复 dispatch 默认拒 exit=1', p.returncode == 1, p.stderr)
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a', '--run', s['run'],
                   '--ref', 'T-001', '--project', proj, '--force'], env)
        c.check('S3 --force 放行 rc=0', p.returncode == 0, p.stderr)
        con = sqlite3.connect(db)
        dup = con.execute("SELECT COUNT(*) FROM events WHERE node_id='T-001' AND detail LIKE '%duplicate(--force)%'").fetchone()[0]
        con.close()
        c.check('S3 duplicate 已记账', dup >= 1)

        # S4 settle worker_done(回调收讫)→ ack+release+node end+ticket end+lease release
        resetspy()
        fx = delivery([{'id': 'm1', 'type': 'worker_done',
                        'payload': json.dumps({'taskId': s['task'], 'dispatchId': s['ctx'], 'outcome': '全部落地'})}],
                      'dlv_1')
        p = _orch(['settle', '--run', s['run'], '--payload-file', fx], env)
        c.check('S4 worker_done rc=0', p.returncode == 0, p.stderr + p.stdout)
        c.check('S4 node end', get_node(proj, 'T-001')['status'] == 'end')
        c.check('S4 ticket end+lease 释放', get_ticket('T-001') == {'state': 'end', 'lease_owner': None},
                str(get_ticket('T-001')))
        c.check('S4 ack 恰一次', open(env['ORCH_FAKE_ACKS']).read().split().count('dlv_1') == 1)
        c.check('S4 release 恰一次 ctx', open(env['ORCH_FAKE_RELEASES']).read().split() == [s['ctx']],
                open(env['ORCH_FAKE_RELEASES']).read())
        # S5 幂等重放: 同 delivery 再 settle 不二次 ack/记账
        p = _orch(['settle', '--run', s['run'], '--payload-file', fx], env)
        c.check('S5 重放 rc=0 且 skip', p.returncode == 0 and 'already settled' in p.stdout, p.stdout + p.stderr)
        c.check('S5 ack 仍一次', open(env['ORCH_FAKE_ACKS']).read().split().count('dlv_1') == 1)
        c.check('S5 node 仍 end(未重复迁移)', get_node(proj, 'T-001')['status'] == 'end')

        # S6 question → 不 ack, node/ticket blocked, 打印 reply 模板
        resetspy()
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a', '--new-run', 'q',
                   '--ref', 'T-002', '--project', proj, '--json'], env)
        s2 = json.loads(p.stdout.strip().splitlines()[-1])
        fx = delivery([{'id': 'm2', 'type': 'question', 'subject': '用 A 还是 B?', 'payload': ''}], 'dlv_2')
        p = _orch(['settle', '--run', s2['run'], '--payload-file', fx, '--json'], env)
        c.check('S6 question rc=2', p.returncode == 2, p.stdout + p.stderr)
        acks = open(env['ORCH_FAKE_ACKS']).read().split() if os.path.exists(env['ORCH_FAKE_ACKS']) else []
        c.check('S6 不 ack', 'dlv_2' not in acks and not acks, str(acks))
        c.check('S6 node blocked', get_node(proj, 'T-002')['status'] == 'blocked')
        c.check('S6 ticket blocked', get_ticket('T-002')['state'] == 'blocked', str(get_ticket('T-002')))
        c.check('S6 打印 reply 模板', 'orch reply --msg m2' in p.stdout and '回调' in p.stdout, p.stdout)

        # S7 escalation → ack+release+blocked, rc=3
        resetspy()
        fx = delivery([{'id': 'm3', 'type': 'escalation', 'payload': json.dumps({'dispatchId': s2['ctx'],
                                                                                'outcome': '卡在依赖'})}], 'dlv_3')
        p = _orch(['settle', '--run', s2['run'], '--payload-file', fx], env)
        c.check('S7 escalation rc=3', p.returncode == 3, p.stdout + p.stderr)
        c.check('S7 已 ack', 'dlv_3' in open(env['ORCH_FAKE_ACKS']).read().split())
        c.check('S7 已 release', s2['ctx'] in open(env['ORCH_FAKE_RELEASES']).read().split())
        c.check('S7 node blocked', get_node(proj, 'T-002')['status'] == 'blocked')

        # S8 缺 payload → 用法拒绝 exit=64, 账不动(阻塞拉取已退役,无超时检查点语义)
        resetspy()
        p = _orch(['settle', '--run', s2['run']], env)
        c.check('S8 缺 payload 拒绝 exit=64', p.returncode == 64, p.stderr)
        c.check('S8 零 ack', not os.path.exists(env['ORCH_FAKE_ACKS']))
        c.check('S8 node 态不变(blocked)', get_node(proj, 'T-002')['status'] == 'blocked')

        # S9/S10 状态机: 非法拒/合法链通/同态幂等
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a', '--new-run', 'm',
                   '--ref', 'T-003', '--project', proj, '--json'], env)
        c.check('S9 前置 dispatch T-003 rc=0', p.returncode == 0, p.stderr)
        p = _orch(['_transition', '--project', proj, '--node', 'T-003', '--to', 'end'], env)
        c.check('S9 dispatched→end 非法拒绝 exit=1', p.returncode == 1 and '非法状态流转' in p.stderr, p.stderr)
        p = _orch(['_transition', '--project', proj, '--node', 'T-003', '--to', 'running'], env)
        c.check('S10 dispatched→running 合法 rc=0', p.returncode == 0, p.stderr)
        p = _orch(['_transition', '--project', proj, '--node', 'T-003', '--to', 'end'], env)
        c.check('S10 running→end 合法 rc=0', p.returncode == 0, p.stderr)
        p = _orch(['_transition', '--project', proj, '--node', 'T-003', '--to', 'end'], env)
        c.check('S10 同态重写幂等 no-op rc=0', p.returncode == 0 and 'noop' in p.stdout, p.stdout)

        # S11 reply → stub 记录 + 提示重挂
        resetspy()
        p = _orch(['reply', '--msg', 'm2', '--body', '选 A', '--run', s2['run']], env)
        c.check('S11 reply rc=0 + 回调提示', p.returncode == 0 and '回调' in p.stdout, p.stdout + p.stderr)
        rep = [json.loads(l) for l in open(env['ORCH_FAKE_REPLIES'])]
        c.check('S11 reply 抵达 stub', len(rep) == 1 and rep[0]['id'] == 'm2', str(rep))

        # S12 dry-run: 打印命令序列,零写路径调用(spec 走 stdin '-')
        resetspy()
        p = subprocess.run([sys.executable, os.path.abspath(__file__), 'dispatch', '--spec', '-', '--to',
                            'term_a', '--new-run', 'dry', '--ref', 'T-DRY', '--project', proj, '--dry-run'],
                           input='dry spec\n', capture_output=True, text=True, timeout=60, env=env, cwd=proj)
        c.check('S12 dry-run rc=0 且打印 [dry] 序列', p.returncode == 0 and '[dry]' in p.stderr, p.stderr)
        c.check('S12 零 stub 写路径调用', calls() == [], str(calls()))
        c.check('S12 dry-run 未落账', get_node(proj, 'T-DRY') is None)

        # S13 status 合并视图
        p = _orch(['status', '--ref', 'T-002', '--project', proj], env)
        c.check('S13 status 含 node 态+refs', p.returncode == 0 and 'T-002' in p.stdout
                and 'blocked' in p.stdout and 'run=' in p.stdout, p.stdout)
        p = _orch(['status', '--project', proj, '--json'], env)
        try:
            rows = json.loads(p.stdout.strip().splitlines()[-1])
        except Exception:
            rows = []
        c.check('S13 --json 结构化', isinstance(rows, list) and len(rows) >= 3
                and all('refs' in r for r in rows), p.stdout[:200])

        # S14 同 run 不同 delivery 正常处理(幂等按 deliveryId 键,不误吞)
        resetspy()
        fx = delivery([{'id': 'm4', 'type': 'worker_done',
                        'payload': json.dumps({'dispatchId': 'ctx_x', 'outcome': 'S14'})}], 'dlv_4')
        p = _orch(['settle', '--run', s2['run'], '--payload-file', fx], env)
        c.check('S14 新 delivery 正常收口 rc=0', p.returncode == 0, p.stdout + p.stderr)
        c.check('S14 ack 到位', 'dlv_4' in open(env['ORCH_FAKE_ACKS']).read().split())

        # S15/S16 running 帧消费(orch-hooks sidecar;契约形态见 docstring)
        def push_frame(**kw):
            with open(env['ORCH_RUNNING_LOG'], 'a') as f:
                f.write(json.dumps(kw, ensure_ascii=False) + '\n')
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a', '--new-run', 'r15',
                   '--ref', 'T-004', '--project', proj, '--json'], env)
        s4 = json.loads(p.stdout.strip().splitlines()[-1])
        push_frame(type='ticket-running', to='test-orch@test-session', **{'from': 'worker-sess-1'},
                   body=f"[task:{s4['task']}] worker turn started (dispatch-injected) session=worker-sess-1",
                   ref=s4['task'], msgid='rm1', ts='t', ver=3)
        p = _orch(['status', '--ref', 'T-004', '--project', proj], env)
        c.check('S15 running 帧 node→running', get_node(proj, 'T-004')['status'] == 'running', p.stderr)
        c.check('S15 ticket→running', (get_ticket('T-004') or {}).get('state') == 'running', str(get_ticket('T-004')))
        push_frame(type='ticket-running', to='test-orch@test-session', **{'from': 'worker-sess-1'},
                   body=f"[task:{s4['task']}] worker turn started", ref=s4['task'], msgid='rm1', ts='t', ver=3)
        p = _orch(['status', '--ref', 'T-004', '--project', proj], env)
        con = sqlite3.connect(db)
        n_run_ev = con.execute("SELECT COUNT(*) FROM events WHERE node_id='T-004' AND event_type='running'").fetchone()[0]
        con.close()
        c.check('S15 幂等: 重复帧/已 running 不重记', n_run_ev == 1, f'running 事件数={n_run_ev}')

        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a', '--new-run', 'r16a',
                   '--ref', 'T-005', '--project', proj, '--json'], env)
        s5 = json.loads(p.stdout.strip().splitlines()[-1])
        push_frame(type='ticket-running', to='test-orch@test-session', **{'from': 'w2'},
                   body=f"[task:{s5['task']}] worker turn started", msgid='rm2', ver=3)   # 无 ref 字段
        p = _orch(['status', '--ref', 'T-005', '--project', proj], env)
        c.check('S16a ref 缺失走 body-task 兜底', get_node(proj, 'T-005')['status'] == 'running', p.stderr)

        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--to', 'term_a', '--new-run', 'r16b',
                   '--ref', 'T-006', '--project', proj, '--json'], env)
        push_frame(type='ticket-running', to='other-orch@other-session', **{'from': 'w3'},
                   body='[task:task_zzz] worker turn started', ref='T-006', msgid='rm3', ver=3)
        p = _orch(['status', '--ref', 'T-006', '--project', proj], env)
        c.check('S16b 错址帧(to=他人)不消费', get_node(proj, 'T-006')['status'] == 'dispatched', p.stderr)

        # S16c 半签帧(裸别名缺 @session,hook 端 ORCH_SIG 退化形态) → WARN 不消费
        push_frame(type='ticket-running', to='test-orch', **{'from': 'w4'},
                   body='[task:task_zzz] worker turn started', ref='T-006', msgid='rm4', ver=3)
        p = _orch(['status', '--ref', 'T-006', '--project', proj], env)
        c.check('S16c 半签帧 WARN 且不消费', '未消费' in p.stderr
                and get_node(proj, 'T-006')['status'] == 'dispatched', p.stderr)

        # S17 refs 异形态防御(实测定界: 账内存有 list/null 字面量/坏JSON/SQL NULL)
        con = sqlite3.connect(db)
        for nid, refs_val in (('BAD-LIST', '["flow:x","run_fake0"]'), ('BAD-NULLLIT', 'null'),
                              ('BAD-STR', 'not-json{'), ('BAD-NULL', None)):
            con.execute("INSERT INTO nodes(project_key,node_id,kind,title,status,owner,refs,updated_at) "
                        "VALUES(?,?,?,?,?,?,?,?)", (proj, nid, 'session', f'bad {nid}', 'running', None, refs_val, 't'))
        con.commit()
        con.close()
        p = _orch(['status', '--project', proj], env)
        c.check('S17 status 全量渲染不崩 rc=0', p.returncode == 0, p.stderr[-300:])
        c.check('S17 坏行 WARN×3 不中断且好行照渲', p.stderr.count('WARN') >= 3
                and 'BAD-LIST' in p.stdout and 'BAD-NULL' in p.stdout, p.stderr[-300:])
        p = _orch(['status', '--project', proj, '--json'], env)
        c.check('S17 --json 亦不崩且带 refs_warn', p.returncode == 0 and '"refs_warn"' in p.stdout, p.stdout[:120])
        # S17b settle 解析面(find_node_by_run 扫到 list 型 refs)不崩
        fx5 = delivery([{'id': 'm5', 'type': 'worker_done',
                         'payload': json.dumps({'dispatchId': 'ctx_x', 'outcome': 'S17b'})}], 'dlv_5')
        p = _orch(['settle', '--run', 'run_fake0', '--project', proj, '--payload-file', fx5], env)
        c.check('S17b settle 解析面遇坏 refs 不崩 rc=0', p.returncode == 0, p.stdout + p.stderr)

        # S18 bridge 武装硬门(ORCH-WAKE ②): 回调单车道,未武装 dispatch(含 --dry-run)拒绝 + arm 指引
        bare = dict(env)
        bare.pop('ORCH_SIG', None)
        bare.pop('MAESTRO_ORCH_SIGNATURE', None)
        bare.pop('ORCH_BRIDGE_REGISTRY', None)
        bare['MAESTRO_HOME'] = tmp   # 隔离真机 bridge/orch.signature 兜底(硬门先于一切 ledger/orca 调用,零实弹)
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--new-run', 'r18a', '--ref', 'T-018a',
                   '--project', proj, '--json'], bare)
        c.check('S18a 无签名 dispatch 拒绝 rc=1', p.returncode == 1, (p.stdout + p.stderr)[-200:])
        c.check('S18a 拒绝带 arm 指引与硬门口径', 'bridge 武装硬门' in p.stderr and 'arm 指引' in p.stderr, p.stderr[-200:])
        bare2 = dict(env)
        bare2['ORCH_SIG'] = 'ghost-orch@session-ghost'   # 有签名但不在册
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--new-run', 'r18b', '--ref', 'T-018b',
                   '--project', proj, '--json'], bare2)
        c.check('S18b 有签名未在册拒绝', p.returncode == 1 and '无在册 bridge consumer' in p.stderr, p.stderr[-200:])
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--new-run', 'r18c', '--ref', 'T-018c',
                   '--project', proj, '--dry-run'], bare2)
        c.check('S18c --dry-run 亦受硬门约束', p.returncode == 1 and '无在册 bridge consumer' in p.stderr, p.stderr[-200:])
        p = _orch(['dispatch', '--spec', os.path.join(proj, 'spec.md'), '--new-run', 'r18d', '--ref', 'T-018d',
                   '--project', proj, '--dry-run', '--json'], env)
        c.check('S18d 在册 consumer --dry-run 放行 rc=0', p.returncode == 0, p.stderr[-200:])

        # ── S19-S22 dag 族收编(ORCH-UNIFY;offline fixture,零实弹) ────────────────
        env['ORCH_FAKE_WTPATH'] = proj
        dstate = os.path.join(tmp, 'state', 'orch-dag.json')   # ORCH_STATE_DIR 已隔离,承 orch-dag 旧档路径

        # S19 未武装拒派(V3: dag 派发链过 bridge 武装硬门,S18 口径)
        dag_bare = dict(env)
        for k in ('ORCH_SIG', 'MAESTRO_ORCH_SIGNATURE', 'ORCH_BRIDGE_REGISTRY'):
            dag_bare.pop(k, None)
        dag_bare['MAESTRO_HOME'] = tmp
        for dargs in (['dag-seat-open', '--project', proj], ['dag-run', 'x'],
                      ['dag-task', 'DX-1', '--title', 't', '--spec', 's'], ['dag-seat', 'DX-1']):
            p = _orch(dargs, dag_bare, cwd=proj)
            c.check(f'S19 未武装 {dargs[0]} 拒绝 rc=1', p.returncode == 1, (p.stdout + p.stderr)[-160:])
        p = _orch(['dag-seat-open', '--project', proj], dag_bare, cwd=proj)
        c.check('S19 拒绝带 arm 指引', 'bridge 武装硬门' in p.stderr and 'arm 指引' in p.stderr, p.stderr[-200:])
        ghost = dict(env)
        ghost['ORCH_SIG'] = 'ghost-orch@session-ghost'   # 有签名但不在册
        p = _orch(['dag-seat', 'DR-1'], ghost, cwd=proj)
        c.check('S19 有签名未在册 dag-seat 拒绝', p.returncode == 1 and '无在册 bridge consumer' in p.stderr,
                p.stderr[-160:])

        # S20 seat-open/run 建立与幂等复用
        p = _orch(['dag-seat-open', '--project', proj], env, cwd=proj)
        c.check('S20 dag-seat-open rc=0', p.returncode == 0, p.stderr)
        st = json.load(open(dstate))
        c.check('S20 seat+project 落态', st.get('seat') == 'term_seat' and st.get('project') == proj, str(st))
        _orch(['dag-seat-open', '--project', proj], env, cwd=proj)
        c.check('S20 seat-open 幂等(终端只开一次)',
                sum(1 for x in calls() if x[:2] == ['terminal', 'create']) == 1, str(calls()[-3:]))
        p = _orch(['dag-run', 'R41 类瀑布重放'], env, cwd=proj)
        c.check('S20 dag-run rc=0', p.returncode == 0, p.stderr)
        st = json.load(open(dstate))
        c.check('S20 run 落态 run_*', str(st.get('run', '')).startswith('run_'), str(st))
        n_rc = sum(1 for x in calls() if x[:2] == ['orchestration', 'run-create'])
        p = _orch(['dag-run', 'again'], env, cwd=proj)
        c.check('S20 run 幂等复用(不重 create)', p.returncode == 0
                and sum(1 for x in calls() if x[:2] == ['orchestration', 'run-create']) == n_rc)
        fresh = dict(env)
        fresh['ORCH_DAG_STATE'] = os.path.join(tmp, 'state', 'dag-fresh.json')
        p = _orch(['dag-run', 'x'], fresh, cwd=proj)
        c.check('S20b 未建 seat 先 run 拒绝 exit=64', p.returncode == 64 and 'dag-seat-open' in p.stderr,
                p.stderr[-160:])

        # S21 deps 硬屏障(本地层 fail-loud)+ R41 类瀑布重放(V4)
        p = _orch(['dag-task', 'DR-2', '--title', 'T2', '--spec', 's2', '--deps', 'DR-1X'], env, cwd=proj)
        c.check('S21 依赖未建拒绝 rc=1(本地屏障)', p.returncode == 1 and 'deps 硬屏障' in p.stderr, p.stderr[-200:])
        c.check('S21 拒绝零副作用(票未建)', get_ticket('DR-2') is None, str(get_ticket('DR-2')))
        p = _orch(['dag-task', 'DR-1', '--title', 'T1', '--spec', 's1'], env, cwd=proj)
        c.check('S21 dag-task DR-1 rc=0', p.returncode == 0, p.stderr)
        t1 = get_ticket('DR-1')
        c.check('S21 票初始 dispatched', bool(t1) and t1['state'] == 'dispatched', str(t1))
        refs1 = dag_ticket_refs('DR-1') or {}
        c.check('S21 票 refs.cwd/orca_task 双写(341a100 语义)', refs1.get('cwd') == proj
                and str(refs1.get('orca_task', '')).startswith('task_'), str(refs1))
        st = json.load(open(dstate))
        c.check('S21 state.refs 记 orca_task', str(st['refs']['DR-1'].get('orca_task', '')).startswith('task_'), str(st))
        p = _orch(['dag-task', 'DR-2', '--title', 'T2', '--spec', 's2', '--deps', 'DR-1'], env, cwd=proj)
        c.check('S21 dag-task DR-2(dep DR-1) rc=0', p.returncode == 0, p.stderr)
        p = _orch(['dag-task', 'DR-3', '--title', 'T3', '--spec', 's3', '--deps', 'DR-1,DR-2'], env, cwd=proj)
        c.check('S21 瀑布 DR-3(deps R1,R2) rc=0', p.returncode == 0, p.stderr)
        st = json.load(open(dstate))
        tid1, tid2 = st['refs']['DR-1']['orca_task'], st['refs']['DR-2']['orca_task']
        tcs = [x for x in calls() if x[:2] == ['orchestration', 'task-create']]

        def tc_deps(title):
            for x in tcs:
                if '--task-title' in x and x[x.index('--task-title') + 1] == title:
                    return json.loads(x[x.index('--deps') + 1]) if '--deps' in x else []
            return None
        c.check('S21 Orca --deps 瀑布透传(V4)', tc_deps('T2') == [tid1] and tc_deps('T3') == [tid1, tid2], str(tcs))

        # S21c deps 建票前预校验(CONTRACT-HYGIENE): refs 在而 ledger 无 → exit 2 列坏票号,零落票(Orca task 也不建)
        #   R41/R42 写账伪影同型复现: dag state 有 orca_task、ledger 票号缺/错双前缀 → 机器锁 fail-loud
        n_tc = len([x for x in calls() if x[:2] == ['orchestration', 'task-create']])
        st = json.load(open(dstate))
        st['refs']['DR-GHOST'] = {'orca_task': 'task_ghost', 'ticket': True}
        st['refs']['DR-GHOST2'] = {'orca_task': 'task_ghost2', 'ticket': True}
        json.dump(st, open(dstate, 'w'))
        p = _orch(['dag-task', 'DR-BAD', '--title', 'TB', '--spec', 'sb',
                   '--deps', 'DR-GHOST,DR-GHOST2,DR-1'], env, cwd=proj)
        c.check('S21c 坏 deps(state 有 ledger 无)拒绝 rc=2', p.returncode == 2
                and 'DR-GHOST' in p.stderr and 'DR-GHOST2' in p.stderr, p.stderr[-200:])
        c.check('S21c 指引只列坏票号(好票 DR-1 不在发言)', 'DR-1' not in p.stderr, p.stderr[-200:])
        c.check('S21c 拒绝零落票(ledger 无 DR-BAD)', get_ticket('DR-BAD') is None, str(get_ticket('DR-BAD')))
        st = json.load(open(dstate))
        c.check('S21c 拒绝零落账(state.refs 无 DR-BAD)', 'DR-BAD' not in st['refs'], str(sorted(st['refs'])))
        c.check('S21c 拒绝零 Orca task(先于 task-create 断)',
                len([x for x in calls() if x[:2] == ['orchestration', 'task-create']]) == n_tc, str(calls()[-2:]))
        p = _orch(['dag-task', 'DR-4', '--title', 'T4', '--spec', 's4', '--deps', 'DR-3'], env, cwd=proj)
        c.check('S21c 好 deps 不回归 rc=0', p.returncode == 0, p.stderr)

        # S22 dag-seat 派发: worker-start(硬编码 omp×new-top-level)+ node/ticket/state 多写
        p = _orch(['dag-seat', 'DR-1'], env, cwd=proj)
        c.check('S22 dag-seat rc=0', p.returncode == 0, p.stderr)
        node = get_node(proj, 'DR-1')
        nrefs = json.loads((node or {}).get('refs') or '{}')
        c.check('S22 node dispatched(kind=dispatch)', bool(node) and node['status'] == 'dispatched'
                and node['kind'] == 'dispatch', str(node))
        c.check('S22 node refs run/orca_task/dispatch',
                all(nrefs.get(k) for k in ('run', 'orca_task', 'dispatch')), str(nrefs))
        ws = [x for x in calls() if x[:2] == ['orchestration', 'worker-start']]
        c.check('S22 worker-start 硬编码 omp×new-top-level', len(ws) == 1
                and ws[0][ws[0].index('--agent') + 1] == 'omp'
                and ws[0][ws[0].index('--worktree') + 1] == 'new-top-level', str(ws))
        c.check('S22 票态仍 dispatched', (get_ticket('DR-1') or {}).get('state') == 'dispatched',
                str(get_ticket('DR-1')))
        drefs = dag_ticket_refs('DR-1') or {}
        c.check('S22 refs-set 落 dispatch/worktree/agent', str(drefs.get('dispatch', '')).startswith('ctx_')
                and drefs.get('worktree') == 'dr-1' and drefs.get('agent') == 'omp', str(drefs))

        # S22b --base-branch 双保险(dbdeb83 语义收编): state.worker_base_ref → worker-start 透传
        p = _orch(['dag-seat-open', '--project', proj, '--base-branch', 'feat/gui-cockpit-nav'], env, cwd=proj)
        c.check('S22b 复用席位+基点更新 rc=0', p.returncode == 0 and 'worker_base_ref' in p.stdout,
                p.stdout + p.stderr)
        st = json.load(open(dstate))
        c.check('S22b state.worker_base_ref 落态', st.get('worker_base_ref') == 'feat/gui-cockpit-nav', str(st))
        p = _orch(['dag-seat', 'DR-2'], env, cwd=proj)
        c.check('S22b dag-seat DR-2 rc=0', p.returncode == 0, p.stderr)
        ws2 = [x for x in calls() if x[:2] == ['orchestration', 'worker-start']]
        c.check('S22b worker-start 带显式 --base-branch', len(ws2) == 2 and '--base-branch' in ws2[1]
                and ws2[1][ws2[1].index('--base-branch') + 1] == 'feat/gui-cockpit-nav', str(ws2[1]))
        # S21e 信封上车(HOOK-ENVELOPE A′): dag-task 注入文本首行=合法 DSHMSG 信封,正文原样跟随
        def tc_spec(title):
            for x in calls():   # 每次现读: 此 helper 供后续新 dag-task 断言复用
                if (x[:2] == ['orchestration', 'task-create'] and '--task-title' in x
                        and x[x.index('--task-title') + 1] == title):
                    return x[x.index('--spec') + 1]
            return None
        sp1 = tc_spec('T1') or ''
        first = sp1.split('\n', 1)[0]
        envj = {}
        try:
            envj = json.loads(first[len('DSHMSG]'):]) if first.startswith('DSHMSG]') else {}
        except json.JSONDecodeError:
            envj = {}
        c.check('S21e 注入文本首行 DSHMSG 信封 jq 可析', bool(envj), first[:120])
        c.check('S21e from=回落链(env ORCH_SIG)', envj.get('from') == 'test-orch@test-session', str(envj))
        c.check('S21e ref=票REF type=dispatch ver=3 to=-',
                envj.get('ref') == 'DR-1' and envj.get('type') == 'dispatch'
                and envj.get('ver') == 3 and envj.get('to') == '-', str(envj))
        c.check('S21e msgid 唯一(uuid4)',
                len(str(envj.get('msgid', ''))) == 36 and envj.get('msgid', '').count('-') == 4,
                str(envj.get('msgid')))
        c.check('S21e 正文原样跟在信封后', sp1.split('\n', 1)[1] == 's1', repr(sp1[:40]))
        p = _orch(['dag-task', 'DR-ENV', '--title', 'TE', '--spec', 'se',
                   '--orch-sig', 'alt-orch@session-alt'], env, cwd=proj)
        c.check('S21e --orch-sig 覆盖回落链 rc=0', p.returncode == 0, p.stderr[-160:])
        spe = tc_spec('TE') or ''
        try:
            envy = json.loads(spe.split('\n', 1)[0][len('DSHMSG]'):])
        except (json.JSONDecodeError, IndexError):
            envy = {}
        c.check('S21e --orch-sig 传入值即 from', envy.get('from') == 'alt-orch@session-alt', spe[:120])
        msg1 = str(envj.get('msgid'))
        msg2 = str(envy.get('msgid'))
        c.check('S21e msgid 跨票唯一', msg1 != msg2, f'{msg1} vs {msg2}')

        # S21f SIG-MANDATE(issue#1): 签名=显式必传(旗标/env),seat 落态/签名文件/字面零回落——
        #   多席共册末写者胜的 state.orch_sig 是错绑源(orch-e2e E2E 实证);缺席 die(2) 附获取法
        fenv = dict(env)
        fenv.pop('ORCH_SIG', None)
        fenv['MAESTRO_HOME'] = tmp   # 签名文件链定向(在场也不得绑)
        sigdir = os.path.join(tmp, 'maestro', 'bridge')
        fbin = os.path.join(tmp, 'maestro', 'bin')   # LEDGER_BIN 随 MAESTRO_DIR 重定向 → 符号链接回真身
        os.makedirs(fbin, exist_ok=True)
        _real_ledger = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'bin', 'ledger')
        if not os.path.exists(os.path.join(fbin, 'ledger')):
            os.symlink(_real_ledger, os.path.join(fbin, 'ledger'))
        os.makedirs(sigdir, exist_ok=True)
        with open(os.path.join(sigdir, 'orch.signature'), 'w') as f:
            f.write('file-orch@session-file')
        freg = os.path.join(tmp, 'bridge-registry-fenv.json')
        with open(freg, 'w') as f:
            json.dump({'version': '4.1.0', 'consumers': {
                'session-file': {'alias': 'file-orch', 'pid': os.getpid(), 'armedAt': now()},
                'session-seat': {'alias': 'seat-orch', 'pid': os.getpid(), 'armedAt': now()},
                'session-envs': {'alias': 'env-orch', 'pid': os.getpid(), 'armedAt': now()}}}, f)
        fenv['ORCH_BRIDGE_REGISTRY'] = freg
        fenv['ORCH_DAG_STATE'] = os.path.join(tmp, 'state', 'dag-fenv.json')
        json.dump({'seat': 'term_seat', 'run': st['run'], 'project': proj, 'refs': {},
                   'orch_sig': 'stale-orch@session-stale'},   # 末写者胜脏落态在场
                  open(fenv['ORCH_DAG_STATE'], 'w'))
        p = _orch(['dag-task', 'DR-F1', '--title', 'FLTF', '--spec', 'ff'], fenv, cwd=proj)
        c.check('S21f 无旗标无 env die(2)(签名文件+脏落态零回落)', p.returncode == 2
                and 'SIG-MANDATE' in p.stderr and 'DSH_SESSION_ID' in p.stderr, p.stderr[-200:])
        c.check('S21f 拒绝零落票(ledger 无 DR-F1)', get_ticket('DR-F1') is None, str(get_ticket('DR-F1')))
        fenv['ORCH_SIG'] = 'env-orch@session-envs'
        p = _orch(['dag-task', 'DR-F1', '--title', 'FLTF', '--spec', 'ff'], fenv, cwd=proj)
        spf = tc_spec('FLTF') or ''
        try:
            envf = json.loads(spf.split('\n', 1)[0][len('DSHMSG]'):])
        except (json.JSONDecodeError, IndexError):
            envf = {}
        c.check('S21f env 槽显式即 from(rc=0 建票)', p.returncode == 0
                and envf.get('from') == 'env-orch@session-envs', spf[:120])
        fenv.pop('ORCH_SIG', None)
        p = _orch(['dag-seat', 'DR-F1', '--orch-sig', 'seat-orch@session-seat'], fenv, cwd=proj)
        c.check('S21f dag-seat --orch-sig rc=0(仅簿记)', p.returncode == 0, p.stderr[-160:])
        stf = json.load(open(fenv['ORCH_DAG_STATE']))
        c.check('S21f 席位级签名落 state.orch_sig(簿记)', stf.get('orch_sig') == 'seat-orch@session-seat', str(stf))
        p = _orch(['dag-task', 'DR-F2', '--title', 'FLTS', '--spec', 'f2'], fenv, cwd=proj)
        c.check('S21f seat 落态不参与解析:仍 die(2)', p.returncode == 2
                and 'SIG-MANDATE' in p.stderr, p.stderr[-160:])
        import importlib.util as _ilu
        from importlib.machinery import SourceFileLoader as _sfl
        _loader = _sfl('orch_mod_selftest', os.path.abspath(__file__))   # 无扩展名脚本须显式 loader
        _spec_o = _ilu.spec_from_loader('orch_mod_selftest', _loader)
        _om = _ilu.module_from_spec(_spec_o)
        _loader.exec_module(_om)
        _saved_sig = os.environ.pop('ORCH_SIG', None)
        _code = None
        try:
            _om.dag_orch_sig(None, None)
        except SystemExit as _e:
            _code = _e.code
        try:
            c.check('S21f 单元级全链落空 die(2)(末位兜底废止)',
                    _code == 2, str(_code))
            c.check('S21f 旗标恒优先(禁硬编码单席)',
                    _om.dag_orch_sig('flag-orch@session-flag', {'orch_sig': 'seat@session-s'}) ==
                    'flag-orch@session-flag', '')
        finally:
            if _saved_sig is not None:
                os.environ['ORCH_SIG'] = _saved_sig

        # S21b 全新账本(ledger.db 尚未建)dag-task 不崩 + ledger 自举
        #   (ORCH-UNIFY 修: 只读连接 connect 失败与查询失败分离;旧写法 finally 踩未绑定 c)
        freshenv = dict(env)
        freshenv['MAESTRO_LEDGER'] = os.path.join(tmp, 'fresh-ledger.db')
        freshenv['ORCH_DAG_STATE'] = os.path.join(tmp, 'state', 'dag-fresh2.json')
        json.dump({'seat': 'term_seat', 'run': st['run'], 'project': proj, 'refs': {}},
                  open(freshenv['ORCH_DAG_STATE'], 'w'))
        p = _orch(['dag-task', 'DF-1', '--title', 'F1', '--spec', 'f1'], freshenv, cwd=proj)
        c.check('S21b 全新账本 dag-task rc=0 无 Traceback', p.returncode == 0
                and 'Traceback' not in p.stderr, p.stderr[-200:])
        freshdb = sqlite3.connect(freshenv['MAESTRO_LEDGER'])
        frow = freshdb.execute("SELECT state FROM tickets WHERE ticket_id='DF-1'").fetchone()
        freshdb.close()
        c.check('S21b ledger 自举写票 dispatched', bool(frow) and frow[0] == 'dispatched', str(frow))
        p = _orch(['dag-settle', 'DF-1', '--outcome', 'fresh 收讫'], freshenv, cwd=proj)
        c.check('S21b 空库 settle rc=0', p.returncode == 0, p.stderr[-160:])
        p = _orch(['dag-close', 'DF-1', 'end', '--outcome', 'fresh-db close'], freshenv, cwd=proj)
        c.check('S21b P1 空库 close rc=0 无 Traceback(编排三表随账本自举)', p.returncode == 0
                and 'Traceback' not in p.stderr, p.stderr[-200:])
        freshdb = sqlite3.connect(freshenv['MAESTRO_LEDGER'])
        ftabs = {r[0] for r in freshdb.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        fev = freshdb.execute("SELECT COUNT(*) FROM events WHERE node_id='DF-1' AND event_type='closed-end'").fetchone()[0]
        fprj = freshdb.execute("SELECT COUNT(*) FROM projects").fetchone()[0]
        freshdb.close()
        c.check('S21b P1 空库自举含 projects/nodes/events 三表', {'projects','nodes','events'} <= ftabs, str(sorted(ftabs)))
        c.check('S21b P1 空库 closed 事件+项目注册在账', fev >= 1 and fprj >= 1, f'ev={fev} projects={fprj}')


        # S23 dag-settle: worker_done 回调收讫→running「复验待关账」+ 幂等 + deps 第三层屏障
        p = _orch(['dag-settle', 'DR-1', '--outcome', 'DR-1 落地'], env, cwd=proj)
        c.check('S23 settle rc=0', p.returncode == 0, p.stderr)
        c.check('S23 票 running', (get_ticket('DR-1') or {}).get('state') == 'running', str(get_ticket('DR-1')))
        c.check('S23 node running', (get_node(proj, 'DR-1') or {}).get('status') == 'running')
        p = _orch(['dag-settle', 'DR-1'], env, cwd=proj)
        c.check('S23 重复收讫幂等 rc=0', p.returncode == 0 and '幂等跳过' in p.stdout, p.stdout + p.stderr)
        c.check('S23 node 仍 running', (get_node(proj, 'DR-1') or {}).get('status') == 'running')
        p = _orch(['dag-settle', 'DR-2'], env, cwd=proj)   # DR-2 dep DR-1(未 end)→ ledger deps 门拒
        c.check('S23 提前收讫 ledger deps 门 fail-loud rc=5', p.returncode == 5
                and 'deps 未就绪' in (p.stdout + p.stderr), (p.stdout + p.stderr)[-200:])
        c.check('S23 DR-2 票态未动', (get_ticket('DR-2') or {}).get('state') == 'dispatched')

        # S24 dag-close: 复验后关账(唯一终态入口);rejected 只记事件不同步 node
        p = _orch(['dag-close', 'DR-1', 'end', '--outcome', '复验通过'], env, cwd=proj)
        c.check('S24 close end rc=0', p.returncode == 0, p.stderr)
        c.check('S24 票 end', (get_ticket('DR-1') or {}).get('state') == 'end', str(get_ticket('DR-1')))
        c.check('S24 node end', (get_node(proj, 'DR-1') or {}).get('status') == 'end')
        con = sqlite3.connect(db)
        ev_done = con.execute("SELECT COUNT(*) FROM events WHERE node_id='DR-1' AND event_type='closed-end'").fetchone()[0]
        con.close()
        c.check('S24 closed-end 事件记账', ev_done >= 1, f'closed-end 事件数={ev_done}')
        p = _orch(['dag-close', 'DR-1', 'end', '--outcome', '复验通过'], env, cwd=proj)
        c.check('S24 P2 close 同态重放幂等 rc=0', p.returncode == 0
                and '幂等跳过' in p.stdout, p.stdout + p.stderr)
        con = sqlite3.connect(db)
        ev_dup = con.execute("SELECT COUNT(*) FROM events WHERE node_id='DR-1' AND event_type='closed-end'").fetchone()[0]
        con.close()
        c.check('S24 P2 幂等重放零重复事件', ev_dup == ev_done, f'{ev_done} -> {ev_dup}')
        _orch(['dag-seat', 'DR-2'], env, cwd=proj)   # deps DR-1 已 end,可派发
        p = _orch(['dag-close', 'DR-2', 'rejected', '--outcome', '复验不过'], env, cwd=proj)
        c.check('S24 close rejected rc=0', p.returncode == 0, p.stderr)
        c.check('S24 票 rejected', (get_ticket('DR-2') or {}).get('state') == 'rejected')
        c.check('S24 node 不同步(仍 dispatched,事件已记)',
                (get_node(proj, 'DR-2') or {}).get('status') == 'dispatched')
        con = sqlite3.connect(db)
        ev_rej = con.execute("SELECT COUNT(*) FROM events WHERE node_id='DR-2' AND event_type='closed-rejected'").fetchone()[0]
        con.close()
        c.check('S24 closed-rejected 事件记账', ev_rej >= 1, f'closed-rejected 事件数={ev_rej}')

        # S25 dag-status 只读视图
        p = _orch(['dag-status', '--json'], env, cwd=proj)
        try:
            sdoc = json.loads(p.stdout.strip().splitlines()[-1])
        except Exception:
            sdoc = {}
        c.check('S25 dag-status --json 结构', p.returncode == 0 and sdoc.get('seat') == 'term_seat'
                and str((sdoc.get('refs') or {}).get('DR-1', '')).startswith('task_'), p.stdout[:200])
        p = _orch(['dag-status'], env, cwd=proj)
        c.check('S25 dag-status 文本 rc=0(走 task-list stub)', p.returncode == 0, p.stderr[-160:])

        # S26 全程零 --wait orca 调用(V1 机器断言;阻塞等待已退役,完成信号=回调)
        bad = [x for x in calls() if '--wait' in x]
        c.check('S26 全程零 --wait orca 调用(V1)', not bad, str(bad[:2]))

        # S27 票面卫生条款在册(CONTRACT-HYGIENE V1): SKILL/cordis 各一处 grep 可见
        #   面自适应: 契约对面(SKILL+cordis 同面成对,仓内与 agent-presets bin 同布局)优先;
        #   纯运行时镜像(~/.dsh/maestro)只有孤 SKILL 陈旧镜像、无 cordis,不成对 → 回落 .agent-presets 契约面
        here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        faces = [here, os.path.join(MAESTRO_HOME, '.agent-presets', 'maestro')]
        pair = next((f for f in faces
                     if os.path.isfile(os.path.join(f, 'shared', 'maestro-orch', 'SKILL.md'))
                     and os.path.isfile(os.path.join(f, 'agent.cordis.yml'))), None)
        skill_md = open(os.path.join(pair, 'shared', 'maestro-orch', 'SKILL.md'),
                        encoding='utf-8').read() if pair else ''
        cordis_yml = open(os.path.join(pair, 'agent.cordis.yml'),
                          encoding='utf-8').read() if pair else ''
        c.check('S27 卫生条款 SKILL.md 在册', bool(skill_md) and '票面卫生(CONTRACT-HYGIENE)' in skill_md
                and '禁留无主测试票' in skill_md, f'face={pair}')
        c.check('S27 卫生条款 agent.cordis.yml 在册', bool(cordis_yml)
                and 'Ticket hygiene (CONTRACT-HYGIENE)' in cordis_yml
                and 'reject-on-sight' in cordis_yml, f'face={pair}')

        print(f'== selftest 完成: {c.n_pass} passed / {c.n_fail} failed')
        return 0 if c.n_fail == 0 else 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

# ── 参数面 ────────────────────────────────────────────────────────────────────
def main():
    ap = argparse.ArgumentParser(prog='orch', description='Orca 编排面高抽象入口(债#9×#11)')
    sub = ap.add_subparsers(dest='cmd', required=True)
    p = sub.add_parser('dispatch', help='run绑定/创建→task→dispatch→ledger 建账,一次调用全链;前置 bridge 武装硬门(未武装即拒,含 --dry-run)')
    p.add_argument('--spec', required=True, help='任务正文文件路径或 - (stdin)')
    p.add_argument('--to', help='目标 terminal handle(缺省时列出活体终端并退出)')
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument('--run', help='续用既有 run')
    g.add_argument('--new-run', help='新建 run,值为 objective 文本')
    p.add_argument('--title', help='task/票标题(默认 ref 或 spec 首行)')
    p.add_argument('--ref', help='业务票号(node/ticket id;缺省用 task_id,且不写 tickets 环)')
    p.add_argument('--project', help='项目 key 或路径(默认 cwd)')
    p.add_argument('--force', action='store_true', help='重复派发放行(记 duplicate)')
    p.add_argument('--no-ticket', action='store_true', help='跳过 tickets 环(不写 pm-web 票面)')
    p.add_argument('--dry-run', action='store_true', help='只打印命令序列,零执行(bridge 武装硬门仍生效)')
    p.add_argument('--json', action='store_true', help='机器可读摘要')
    p.set_defaults(f=cmd_dispatch)
    p = sub.add_parser('settle', help='回调收讫结算(非阻塞): worker_done→ack+release+记账;escalation exit3;question exit2')
    p.add_argument('--run', help='run id(缺省用 last-run 指针)')
    p.add_argument('--project', help='覆盖项目解析(默认 last-run/refs 兜底)')
    p.add_argument('--payload', help='delivery 文档(JSON 字面量;- 读 stdin)')
    p.add_argument('--payload-file', help='delivery 文档文件路径')
    p.add_argument('--json', action='store_true')
    p.set_defaults(f=cmd_settle)
    p = sub.add_parser('reply', help='应答 question(完成信号仍走回调)')
    p.add_argument('--msg', required=True, help='message id')
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument('--body')
    g.add_argument('--body-file')
    p.add_argument('--run')
    p.add_argument('--dry-run', action='store_true')
    p.add_argument('--json', action='store_true')
    p.set_defaults(f=cmd_reply)
    p = sub.add_parser('status', help='run/task/dispatch 生命周期 + ledger 节点并排(离线);进门兼收 running 帧')
    p.add_argument('--run')
    p.add_argument('--ref')
    p.add_argument('--project')
    p.add_argument('--json', action='store_true')
    p.set_defaults(f=cmd_status)
    p = sub.add_parser('dag-seat-open', help='dag 族: 编排席终端幂等创建/复用(派发链,前置 bridge 武装硬门)')
    p.add_argument('--project', required=True, help='项目路径(须在 Orca 树;缺参 argparse 层 exit 2)')
    p.add_argument('--title', default=DAG_SEAT_TITLE)
    p.add_argument('--base-branch', help='worker-start 显式基点分支(state.worker_base_ref;缺省用 repo 默认)')
    p.set_defaults(f=cmd_dag_seat_open)
    p = sub.add_parser('dag-run', help='dag 族: 幂等建/续 Run')
    p.add_argument('objective')
    p.set_defaults(f=cmd_dag_run)
    p = sub.add_parser('dag-task', help='dag 族: Orca task+ticket 环原子建(deps 硬屏障)')
    p.add_argument('ref')
    p.add_argument('--title', required=True)
    p.add_argument('--spec', required=True)
    p.add_argument('--deps', help='逗号分隔依赖 ref(须先 dag-task 建齐)')
    p.add_argument('--orch-sig', help='信封 from 编排席签名(HOOK-ENVELOPE;SIG-MANDATE 二槽强制: 旗标 → env ORCH_SIG;缺席 die(2))')
    p.set_defaults(f=cmd_dag_task)
    p = sub.add_parser('dag-seat', help='dag 族: worker-start(硬编码 omp×new-top-level)+dispatched 双写')
    p.add_argument('ref')
    p.add_argument('--name', help='worktree 名(缺省 ref 小写)')
    p.add_argument('--orch-sig', help='席位级编排席签名(落 dag state.orch_sig;仅记录,信封 from 实际取值仍走 SIG-MANDATE 二槽强制)')
    p.set_defaults(f=cmd_dag_seat)
    p = sub.add_parser('dag-settle', help='dag 族: worker_done 回调收讫→票/node running「复验待关账」')
    p.add_argument('ref')
    p.add_argument('--outcome', default='', help='≤300字 收讫摘要(入事件)')
    p.add_argument('--dispatch', help='顺带 worker-release 的 dispatch id(Orca 原生 worker_done 场景)')
    p.set_defaults(f=cmd_dag_settle)
    p = sub.add_parser('dag-close', help='dag 族: 复验后关账(唯一终态入口,手工)')
    p.add_argument('ref')
    p.add_argument('state', choices=['end', 'done', 'rejected', 'rolled-back', 'blocked'],
                   help='end=复验通过关账正名(done=旧别名兼容);幂等重跑备路:票 end→running 合法,node 保持 end 终态、重结算幂等跳过')
    p.add_argument('--outcome', required=True, help='≤300字 关账摘要')
    p.set_defaults(f=cmd_dag_close)
    p = sub.add_parser('dag-status', help='dag 族: seat/run/refs+Orca task 并排(只读)')
    p.add_argument('--ref')
    p.add_argument('--json', action='store_true')
    p.set_defaults(f=cmd_dag_status)
    p = sub.add_parser('selftest', help='离线自测(fake ORCH_BIN stub 全链走查)')
    p.set_defaults(f=cmd_selftest)
    p = sub.add_parser('_transition', help=argparse.SUPPRESS)
    p.add_argument('--project', required=True)
    p.add_argument('--node', required=True)
    p.add_argument('--to', required=True)
    p.add_argument('--source', default='orch')
    p.set_defaults(f=_transition_cmd)
    a = ap.parse_args()
    a.f(a)

if __name__ == '__main__':
    main()
