#!/usr/bin/env python3
"""session-send — 跨 main 会话消息直发(loopback /api 包装)

用法: session-send [--msgid <id>] <from> <to> <type> <ref> <body>
       session-send --selftest     # 内置自测(临时目录,纯函数断言,零 prompt/HTTP)
  from/to: fleet.json 里的 4 位码(如 orch1/2437),sessionId 前 4 位,或完整 sessionId
  type:    ping|pong|done|ask|steer|nack|ack
  ref:     关联的 ledger node_id(无则填 -)
  body:    单行正文
  --msgid: 可选,透传既有 msgid(重发保号);缺省自动生成 uuid4

信封 v2(OF-001): 收方回合首行 = DSHMSG]{"from","to","type","ref","body","msgid","ts"}
      msgid=uuid4(重发可保号),ts=epoch ms;老键全保留、只增不改(OG5),
      老消费者按 ']'+json.loads 解析,忽略未知键即兼容。
      收方回合首动作可跑 bin/msg-dedup 做同 msgid 去重。
steer 闸(OF-002): resolve 后,type=steer 时查 to 的 fleet 条目属主租约——
      owner 有效且 ≠ from → 拒绝 exit 4 + 冲突行落 <fleet 目录>/fleet-conflicts.jsonl
      (键: msgid/from/to/ts);owner=from/无主/已过期/无条目(直投 sessionId)→ 放行
      + 审计行落 $MAESTRO_STATE/steer-journal.jsonl(reason=owner-self|unowned|
      lease-expired|no-entry)。其余消息类型零影响(OG1)。

环境: DSH_PORT(默认 3080)/ MAESTRO_FLEET(默认 ~/.dsh/maestro/fleet.json)
"""
import json
import os
import sys
import tempfile
import time
import urllib.request
import uuid
from datetime import datetime, timezone


def parse_cli(argv):
    """scan-and-delete 旗标解析(纯函数): --msgid <id>/--selftest 删除后恰 5 位置参。
    返回 (msgid|None, selftest_flag, positionals|None, err);err ∈ None|'msgid'|'arity'。"""
    argv = list(argv)
    msgid = None
    selftest = '--selftest' in argv
    if selftest:
        argv.remove('--selftest')
    if '--msgid' in argv:
        i = argv.index('--msgid')
        if i + 1 >= len(argv):
            return None, False, None, 'msgid'
        msgid = argv[i + 1]
        del argv[i:i + 2]
    if len(argv) != 5:
        return None, selftest, None, 'arity'
    return msgid, selftest, argv, None


def build_envelope(frm, to, typ, ref, body, msgid, ts):
    """信封 v2(OF-001,纯函数): 七键 dict + DSHMSG] 单行(收方按 ']'+json.loads 解析)。"""
    envelope = {'from': frm, 'to': to, 'type': typ, 'ref': ref, 'body': body,
                'msgid': msgid, 'ts': ts}
    return envelope, 'DSHMSG]' + json.dumps(envelope, ensure_ascii=False)


def resolve(key: str, fleet: dict) -> str:
    if key.startswith('session-'):
        return key
    entry = fleet.get('fleet', {}).get(key)
    if entry:
        return entry['sessionId']
    for code, ent in fleet.get('fleet', {}).items():
        sid = ent.get('sessionId')
        if sid and sid.startswith('session-' + key):
            return sid
    sys.exit(f'session-send: unknown code {key!r} (not in fleet.json, not a sessionId prefix)')


def parse_ts(val):
    """ISO 8601 → aware datetime(容忍 Z;naive 视作 UTC);缺/坏 → None。"""
    if not val:
        return None
    try:
        dt = datetime.fromisoformat(str(val).replace('Z', '+00:00'))
    except ValueError:
        return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


def find_entry(key, fleet):
    """按 resolve 同款规则取 to 的 fleet 条目(短码→sessionId 前缀);找不到 → None。"""
    ent = fleet.get('fleet', {}).get(key)
    if isinstance(ent, dict):
        return ent
    for ent in fleet.get('fleet', {}).values():
        sid = ent.get('sessionId') if isinstance(ent, dict) else None
        if sid and sid.startswith('session-' + key):
            return ent
    return None


def best_effort_session(key, fleet):
    """from 的尽力解析(IDX-2,不 exit;解析不了返回 None,老调用零破坏):
    完整 sessionId 原样;短码/前缀查 fleet;未命中 → None(free-form from 照发)。"""
    if key.startswith('session-'):
        return key
    ent = fleet.get('fleet', {}).get(key)
    if isinstance(ent, dict) and ent.get('sessionId'):
        return ent['sessionId']
    for ent in fleet.get('fleet', {}).values():
        sid = ent.get('sessionId') if isinstance(ent, dict) else None
        if sid and sid.startswith('session-' + key):
            return sid
    return None


def registered_consumer_alias(registry_path, session_id):
    """bridge registry 里该 session 的已注册消费者别名(IDX-2);无/坏文件/未注册 → None。"""
    try:
        with open(registry_path, encoding='utf-8') as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    ent = (data.get('consumers') or {}).get(session_id)
    if isinstance(ent, dict):
        return ent.get('alias') or ''
    return None


def identity_advisory(frm, frm_sid, registry_path):
    """IDX-2 from 身份告警(非阻断;事故锚 38c3 冒用 af29)。返回 warn|None。
    主路径: 本进程带 DSH_SESSION_ID(harness 给每个会话的 shell 工具注入,实测
    worker/编排 shell 皆有)且 ≠ from 解析 → 冒用嫌疑大写 WARN;
    降级: 无 DSH_SESSION_ID 且 from 解析命中 bridge registry 已注册消费者签名
    → 'borrowing registered consumer signature' WARN。
    两路都只写 stderr 不阻断(向后兼容,老调用零破坏)。"""
    caller = (os.environ.get('DSH_SESSION_ID') or '').strip() or None
    if caller is not None:
        if frm_sid is not None and frm_sid != caller:
            return (f"SESSION-SEND: FROM IDENTITY MISMATCH — from '{frm}' resolves to "
                    f"{frm_sid} but calling session is {caller}; continuing (non-blocking)")
        return None
    if frm_sid is not None:
        alias = registered_consumer_alias(registry_path, frm_sid)
        if alias is not None:
            return (f"SESSION-SEND: WARNING — borrowing registered consumer signature "
                    f"'{alias}@{frm_sid}'; continuing (non-blocking)")
    return None


def append_jsonl(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'a', encoding='utf-8') as fh:
        fh.write(json.dumps(obj, ensure_ascii=False) + '\n')
        fh.flush()
        os.fsync(fh.fileno())


def steer_gate(frm, to, fleet, fleet_path, msgid, ts):
    """OF-002 控制面闸(只拦 steer): 属主有效且≠from → exit 4+冲突行;否则放行+审计行。"""
    entry = find_entry(to, fleet)
    owner = entry.get('owner') if entry else None
    expires = parse_ts(entry.get('leaseExpiresAt')) if entry else None
    alive = bool(owner and expires and expires > datetime.now(timezone.utc))
    if alive and owner != frm:
        conflicts = os.path.join(os.path.dirname(os.path.abspath(fleet_path)),
                                 'fleet-conflicts.jsonl')
        append_jsonl(conflicts, {'msgid': msgid, 'from': frm, 'to': to, 'ts': ts})
        print(f'session-send: steer REFUSED — {to} leased by {owner} until '
              f'{entry.get("leaseExpiresAt")}; conflict journaled ({conflicts}) msgid={msgid}',
              file=sys.stderr)
        sys.exit(4)
    if alive:
        reason = 'owner-self'
    elif entry is None:
        reason = 'no-entry'
    elif owner:
        reason = 'lease-expired'
    else:
        reason = 'unowned'
    state_dir = os.environ.get('MAESTRO_STATE', os.path.expanduser('~/.dsh/maestro/state'))
    append_jsonl(os.path.join(state_dir, 'steer-journal.jsonl'),
                 {'msgid': msgid, 'from': frm, 'to': to, 'ts': ts, 'reason': reason})


def main() -> None:
    msgid, selftest_flag, pos, err = parse_cli(sys.argv[1:])
    if err == 'msgid':
        print('session-send: --msgid requires a value', file=sys.stderr)
        sys.exit(2)
    if selftest_flag:
        sys.exit(selftest())
    if err == 'arity':
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    frm, to, typ, ref, body = pos
    port = os.environ.get('DSH_PORT', '3080')
    fleet_path = os.environ.get('MAESTRO_FLEET', os.path.expanduser('~/.dsh/maestro/fleet.json'))
    registry_path = os.environ.get('MAESTRO_BRIDGE_REGISTRY',
                                   os.path.expanduser('~/.dsh/maestro/bridge/registry.json'))
    with open(fleet_path) as fh:
        fleet = json.load(fh)
    port = str(fleet.get('port', port))
    to_sid = resolve(to, fleet)
    # IDX-2 from 身份告警(非阻断): 解析得到 from 指向的会话即注记,失配/借名只 WARN
    frm_sid = best_effort_session(frm, fleet)
    warn = identity_advisory(frm, frm_sid, registry_path)
    if warn:
        print(warn, file=sys.stderr)
    msgid = msgid or str(uuid.uuid4())
    ts = int(time.time() * 1000)
    if typ == 'steer':  # OF-002 控制面闸(仅 steer;其余类型零影响)
        steer_gate(frm, to, fleet, fleet_path, msgid, ts)
    _envelope, line = build_envelope(frm, to, typ, ref, body, msgid, ts)

    def _post(mode):
        payload = {
            'sessionId': to_sid,
            'mode': mode,
            'content': [{'type': 'text', 'text': line}],
        }
        wire = {
            'type': 'client-request',
            'rpcId': str(uuid.uuid4()),
            'method': 'session.prompt',
            'payload': payload,
        }
        req = urllib.request.Request(
            f'http://127.0.0.1:{port}/api/session.prompt',
            data=json.dumps(wire, ensure_ascii=False).encode(),
            headers={'content-type': 'application/json'},
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())['result']

    # 编排消息默认 steer 打断:时效性第一,历史仍冻结进 session log(用户裁决 2026-08-29 01:18)
    # steer 被拒即回落 queue(idle 时 dsh prompt 路径 catch-all 返 agent-busy;steer-unavailable 仅 dock action 有)
    # idle 会话 queue 即开新 turn;queue 再失败则 surfaced 为最终错误
    mode = 'steer'
    result = _post(mode)
    if not result.get('ok'):
        mode = 'queue'
        result = _post(mode)
    if not result.get('ok'):
        print('session-send: RPC error:', json.dumps(result.get('error'), ensure_ascii=False))
        sys.exit(1)
    resolved = f' resolved-session={frm_sid[:14]}…' if frm_sid else ''
    print(f"sent {frm} -> {to}({to_sid[:14]}…) type={typ} ref={ref}:{resolved} mode={mode} accepted={result['value']['accepted']}")


# ---------- selftest(临时目录;纯函数断言;绝不发真实 prompt/HTTP) ----------

def selftest():
    tmp = tempfile.mkdtemp(prefix='se-selftest-')
    results = []

    def check(name):
        def deco(fn):
            results.append((name, fn))
            return fn
        return deco

    @check('se:parse-happy')
    def _():
        m, st, pos, err = parse_cli(['--msgid', 'M1', 'a', 'b', 'c', 'd', 'e'])
        assert err is None and m == 'M1' and st is False, (m, st, err)
        assert pos == ['a', 'b', 'c', 'd', 'e'], pos
        m, st, pos, err = parse_cli(['a', 'b', 'c', 'd', 'e'])
        assert err is None and m is None and st is False, (m, st, err)
        assert pos == ['a', 'b', 'c', 'd', 'e'], pos
        m, st, pos, err = parse_cli(['--selftest', 'a', 'b', 'c', 'd', 'e'])
        assert err is None and st is True and pos == ['a', 'b', 'c', 'd', 'e'], (st, err)
        m, st, pos, err = parse_cli(['a', 'b', 'c', 'd', 'e', '--selftest'])
        assert err is None and st is True and len(pos) == 5, (st, err)

    @check('se:parse-errors')
    def _():
        assert parse_cli(['--msgid'])[3] == 'msgid'
        assert parse_cli([])[3] == 'arity'
        assert parse_cli(['a', 'b', 'c'])[3] == 'arity'
        assert parse_cli(['a', 'b', 'c', 'd', 'e', 'f'])[3] == 'arity'

    @check('se:resolve-routes')
    def _():
        fleet = {'fleet': {
            '2437': {'sessionId': 'session-2437abcd-0000-0000-0000-000000000001'},
            'orch1': {'sessionId': 'session-0fffaaaa-0000-0000-0000-000000000002'}}}
        assert resolve('session-full123', fleet) == 'session-full123'  # 完整 sid 原样
        assert resolve('2437', fleet) == 'session-2437abcd-0000-0000-0000-000000000001'
        assert resolve('2437ab', fleet) == 'session-2437abcd-0000-0000-0000-000000000001'
        try:
            resolve('zz99', fleet)
            raise AssertionError('未知键应退出')
        except SystemExit as exc:
            assert exc.code not in (0, None), exc.code

    @check('se:parse-ts-tolerance')
    def _():
        aware = parse_ts('2026-08-28T10:00:00+00:00')
        assert aware is not None and aware.tzinfo is not None
        assert parse_ts('2026-08-28T10:00:00Z') == aware            # 容忍 Z
        naive = parse_ts('2026-08-28T10:00:00')
        assert naive is not None and naive.tzinfo is not None       # naive 视作 UTC
        assert naive == aware
        assert parse_ts('not-a-ts') is None and parse_ts('') is None and parse_ts(None) is None

    @check('se:find-entry-routes')
    def _():
        fleet = {'fleet': {
            'aa11': {'sessionId': 'session-aa11ffff-0-0-0-1'},
            'junk': 'not-a-dict',
            'bb22': {'sessionId': 'session-bb22ffff-0-0-0-2'}}}
        assert find_entry('aa11', fleet) == fleet['fleet']['aa11']  # 短码
        assert find_entry('aa11ff', fleet) == fleet['fleet']['aa11']  # sid 前缀
        assert find_entry('zz99', fleet) is None                     # 未命中
        assert find_entry('junk', fleet) is None                     # 非法条目不炸、不命中

    @check('se:envelope-v2-shape')
    def _():
        env, line = build_envelope('w1', 'orch1', 'done', 'R-1', '正文完成', 'M-9', 1234)
        assert env == {'from': 'w1', 'to': 'orch1', 'type': 'done', 'ref': 'R-1',
                       'body': '正文完成', 'msgid': 'M-9', 'ts': 1234}, env
        assert line.startswith('DSHMSG]'), line
        assert json.loads(line[len('DSHMSG]'):]) == env  # 老消费者 ']'+json.loads 可解析

    @check('se:steer-conflict-blocks')
    def _():
        fleet = {'fleet': {'w9': {'sessionId': 'session-w9', 'owner': 'orchX',
                                  'leaseExpiresAt': '2099-01-01T00:00:00+00:00'}}}
        fleet_path = os.path.join(tmp, 'fleet-c.json')
        with open(fleet_path, 'w') as fh:
            json.dump(fleet, fh)
        saved = os.environ.get('MAESTRO_STATE')
        os.environ['MAESTRO_STATE'] = os.path.join(tmp, 'state')
        try:
            try:
                steer_gate('w1', 'w9', fleet, fleet_path, 'M-c', 42)
                raise AssertionError('他人有效租约 steer 应 exit 4')
            except SystemExit as exc:
                assert exc.code == 4, exc.code
            conflicts = os.path.join(tmp, 'fleet-conflicts.jsonl')
            with open(conflicts) as fh:
                rows = [json.loads(x) for x in fh.read().splitlines()]
            assert rows == [{'msgid': 'M-c', 'from': 'w1', 'to': 'w9', 'ts': 42}], rows
        finally:
            if saved is None:
                os.environ.pop('MAESTRO_STATE', None)
            else:
                os.environ['MAESTRO_STATE'] = saved

    @check('se:steer-reasons-journaled')
    def _():
        cases = [  # (frm, to 条目, 期望 reason)
            ('orchX', {'owner': 'orchX', 'leaseExpiresAt': '2099-01-01T00:00:00+00:00'}, 'owner-self'),
            ('w1', {'owner': 'orchX', 'leaseExpiresAt': '2020-01-01T00:00:00+00:00'}, 'lease-expired'),
            ('w1', {}, 'unowned'),
            ('w1', None, 'no-entry'),
        ]
        fleet = {'fleet': {f'k{i}': dict(e, sessionId=f'session-k{i}') if e else
                           {'sessionId': f'session-k{i}'} for i, (_f, e, _r) in enumerate(cases)}}
        fleet_path = os.path.join(tmp, 'fleet-r.json')
        with open(fleet_path, 'w') as fh:
            json.dump(fleet, fh)
        journal = os.path.join(tmp, 'state', 'steer-journal.jsonl')
        saved = os.environ.get('MAESTRO_STATE')
        os.environ['MAESTRO_STATE'] = os.path.join(tmp, 'state')
        try:
            for i, (frm, _e, want) in enumerate(cases):
                to = f'k{i}' if cases[i][1] is not None else 'zz-unknown'
                steer_gate(frm, to, fleet, fleet_path, f'M-{i}', i)
            with open(journal) as fh:
                rows = [json.loads(x) for x in fh.read().splitlines()]
            got = [r['reason'] for r in rows if r['msgid'].startswith('M-')]
            assert got == [c[2] for c in cases], (got, [c[2] for c in cases])
            assert all(r['from'] and r['to'] and 'ts' in r for r in rows), rows
        finally:
            if saved is None:
                os.environ.pop('MAESTRO_STATE', None)
            else:
                os.environ['MAESTRO_STATE'] = saved

    @check('se:best-effort-session')
    def _():
        fleet = {'fleet': {
            '2437': {'sessionId': 'session-2437abcd-0000-0000-0000-000000000001'},
            'orch1': {'sessionId': 'session-0fffaaaa-0000-0000-0000-000000000002'}}}
        assert best_effort_session('session-full9', fleet) == 'session-full9'  # 完整 sid 原样
        assert best_effort_session('2437', fleet) == 'session-2437abcd-0000-0000-0000-000000000001'
        assert best_effort_session('2437ab', fleet) == 'session-2437abcd-0000-0000-0000-000000000001'
        assert best_effort_session('zz99', fleet) is None  # 未命中 → None(不 exit,老调用零破坏)

    @check('se:registered-consumer-alias')
    def _():
        reg = os.path.join(tmp, 'registry.json')
        with open(reg, 'w') as fh:
            json.dump({'consumers': {'session-abc': {'alias': 'orch-x', 'pid': 1}}}, fh)
        assert registered_consumer_alias(reg, 'session-abc') == 'orch-x'
        assert registered_consumer_alias(reg, 'session-other') is None
        assert registered_consumer_alias(os.path.join(tmp, 'missing.json'), 'session-abc') is None
        bad = os.path.join(tmp, 'bad.json')
        with open(bad, 'w') as fh:
            fh.write('not-json{')
        assert registered_consumer_alias(bad, 'session-abc') is None  # 坏文件不炸

    @check('se:identity-mismatch-warn')
    def _():
        reg = os.path.join(tmp, 'registry.json')  # se:registered-consumer-alias 写入的注册表(session-abc→orch-x)
        saved = os.environ.get('DSH_SESSION_ID')
        try:
            os.environ['DSH_SESSION_ID'] = 'session-caller'
            # from 指向别席 → 大写前缀 MISMATCH WARN(非阻断)
            w = identity_advisory('af29', 'session-af29', reg)
            assert w is not None and w.startswith('SESSION-SEND: FROM IDENTITY MISMATCH'), w
            assert 'session-af29' in w and 'session-caller' in w and 'non-blocking' in w
            # from 指向本席 → 零告警
            assert identity_advisory('session-caller', 'session-caller', reg) is None
            # from 解析不了(free-form)→ 零告警
            assert identity_advisory('ghost', None, reg) is None
            # 降级路: 无 env + from 命中 registry 已注册消费者 → borrowing WARN
            os.environ.pop('DSH_SESSION_ID', None)
            w2 = identity_advisory('af29', 'session-abc', reg)
            assert w2 is not None and 'borrowing registered consumer signature' in w2, w2
            # 降级路: from 未注册 → 零告警
            assert identity_advisory('af29', 'session-unregistered', reg) is None
        finally:
            if saved is None:
                os.environ.pop('DSH_SESSION_ID', None)
            else:
                os.environ['DSH_SESSION_ID'] = saved

    npass = 0
    for name, fn in results:
        try:
            fn()
        except AssertionError as exc:
            print(f'[FAIL] {name}: {exc}')
        except Exception as exc:  # noqa: BLE001
            print(f'[FAIL] {name}: unexpected {type(exc).__name__}: {exc}')
        else:
            print(f'[ ok ] {name}')
            npass += 1
    print(f'session-send selftest: {npass}/{len(results)} passed')
    return 0 if npass == len(results) else 1


if __name__ == '__main__':
    main()
