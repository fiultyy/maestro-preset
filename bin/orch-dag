#!/usr/bin/env python3
"""orch-dag — 已退役(ORCH-UNIFY 入口归一,ADR-013)。

唯一结构化编排入口 = `orch`(~/.dsh/maestro/bin/orch)的 dag 族子命令;
本文件只留退役提示一版(防在用编排会话断粮),下一版删除。

旧 → 新映射:
  orch-dag seat-open  → orch dag-seat-open --project <path> [--base-branch B]
  orch-dag run        → orch dag-run "<objective>"
  orch-dag task       → orch dag-task <REF> --title <t> --spec <s> [--deps R1,R2]
  orch-dag seat       → orch dag-seat <REF> [--name <worktree>]
  orch-dag wait       → 已删除: 完成等待=回调单车道(worker_done 原生唤醒编排席回合,
                        ADR-013);收讫记账 orch dag-settle <REF> [--outcome]
  orch-dag close      → orch dag-close <REF> <done|rejected|rolled-back|blocked> --outcome
  orch-dag status     → orch dag-status [--ref R]
  orch-dag reply      → orch reply --msg <id> --body <t>

生命周期语义原样保留: 硬编码 omp×new-top-level、tickets 环强制勾稽、deps 硬屏障
(本地 fail-loud → Orca task_not_startable 透传 → ledger deps 门)、派发链全路径过
bridge 武装硬门、缺参 argparse 层 exit 2。
"""
import sys


def main():
    print('orch-dag: 已退役(ORCH-UNIFY 入口归一)—— 改用 orch 的 dag 族子命令:', file=sys.stderr)
    print('  seat-open → orch dag-seat-open --project <path> | run → orch dag-run "<objective>"', file=sys.stderr)
    print('  task → orch dag-task <REF> --title <t> --spec <s> [--deps R1,R2] | seat → orch dag-seat <REF>', file=sys.stderr)
    print('  wait 已删除: 完成等待=回调(worker_done 原生唤醒);收讫记账 orch dag-settle <REF>', file=sys.stderr)
    print('  close → orch dag-close <REF> <state> --outcome | status → orch dag-status | reply → orch reply', file=sys.stderr)
    sys.exit(2)


if __name__ == '__main__':
    main()
